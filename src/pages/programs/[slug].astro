---
import CommunityPage from '@/components/community-system/CommunityPage.astro';
import { PROGRAMS } from '@/content/community-site';
import { type Locale } from '@/i18n/constants';

export function getStaticPaths() {
  const locale: Locale = 'id';
  return PROGRAMS.map((program) => ({ params: { slug: program.slug }, props: { locale, currentPath: `/programs/${program.slug}` } }));
}

const { slug } = Astro.params;
const locale = Astro.props.locale as Locale;
---
<CommunityPage kind="program" slug={slug} locale={locale} currentPath={Astro.props.currentPath} />
