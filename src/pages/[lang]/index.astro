---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/layout/Navbar'
import HeroSection from '../../components/home/HeroSection'
import DestinationShowcase from '../../components/home/DestinationShowcase'
import CommunityGateway from '../../components/home/CommunityGateway'
import LandingDirection from '../../components/home/LandingDirection'
import AboutSection from '../../components/home/AboutSection'
import CTASection from '../../components/home/CTASection'
import { BlogSection } from '../../components/blog/BlogSection'
import Footer from '../../components/layout/Footer'
import { getCollection } from 'astro:content'
import { LOCALES } from '../../i18n/constants'
import type { Locale } from '../../i18n/constants'
import '../../styles/global.css'

export function getStaticPaths() {
  return LOCALES
    .map((locale) => ({
      params: { lang: locale },
      props: { locale },
    }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const currentPath = Astro.url.pathname;

const blogPosts = await getCollection('blog', ({ data }) => !data.draft)
const gscVerification = import.meta.env.GOOGLE_SITE_VERIFICATION;
const pageTitle = locale === 'id'
  ? '#KaburAjaDulu | Mulai dari pertanyaanmu'
  : '#KaburAjaDulu | Start with your question';
const pageDescription = locale === 'id'
  ? 'Periksa program komunitas, status agenda, dan jalur relawan sebelum menentukan langkah berikutnya.'
  : 'Check community programs, schedule status, and volunteer paths before choosing your next step.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  gscVerification={gscVerification}
  locale={locale}
  currentPath={currentPath}
>
  <Navbar client:only="react" locale={locale} currentPath={currentPath} />
  <main id="main-content" tabindex="-1">
    {locale !== 'id' && locale !== 'en' && (
      <p class="kad-translation-notice" lang="en" role="status">
        Some community sections remain in English while their full translation is prepared.
      </p>
    )}
    <HeroSection client:only="react" locale={locale} />
    <CommunityGateway locale={locale} />
    <DestinationShowcase client:only="react" locale={locale} />
    <LandingDirection direction="field-notes" locale={locale} showFallbackNotice={false} />
    <AboutSection client:only="react" locale={locale} />
    {blogPosts.length > 0 && <BlogSection client:only="react" posts={blogPosts} locale={locale} />}
    <CTASection client:only="react" locale={locale} />
  </main>
  <Footer client:only="react" locale={locale} />
</Layout>
