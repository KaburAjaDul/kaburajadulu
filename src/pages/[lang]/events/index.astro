---
import CommunityPage from '@/components/community-system/CommunityPage.astro';
import { LOCALES, type Locale } from '@/i18n/constants';
export function getStaticPaths() { return LOCALES.filter((locale) => locale !== 'id').map((locale) => ({ params: { lang: locale } })); }
const locale = Astro.params.lang as Locale;
---
<CommunityPage kind="events" locale={locale} currentPath={`/${locale}/events`} />
