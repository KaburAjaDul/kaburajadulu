---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer';
import LiveProgramDetail from '@/components/programs/LiveProgramDetail';
import { LOCALES, type Locale } from '@/i18n/constants';
import '@/styles/agenda.css';
export function getStaticPaths() { return LOCALES.filter((locale) => locale !== 'id').map((locale) => ({ params: { lang: locale } })); }
const locale = Astro.params.lang as Locale;
const currentPath = `/${locale}/programs/live/`;
const fallback = locale !== 'id' && locale !== 'en' && locale !== 'ar';
const title = locale === 'ar' ? 'نوادي Study Club المباشرة — KaburAjaDulu' : 'Live Study Clubs — KaburAjaDulu';
const description = locale === 'ar' ? 'الجداول التشغيلية لـ Study Club من فعاليات Discord المجدولة المعتمدة.' : 'Operational Study Club schedules from approved Discord Scheduled Events.';
---
<Layout title={title} description={description} canonical={`https://kaburajadulu.com${currentPath}`} locale={locale} currentPath={currentPath}>
  <Navbar client:only="react" locale={locale} currentPath={currentPath} />
  <main id="main-content" class="kad-page kad-page--task" lang={locale === 'ar' ? 'ar' : 'en'} data-page-family="program-live-detail">
    <div class="kad-container">{fallback && <p class="kad-translation-notice" data-translation-fallback="true" lang="en" role="note">This live schedule is available in English while a full translation is prepared.</p>}<LiveProgramDetail client:load locale={locale} initialProgram={Astro.url.searchParams.get('program') ?? ''} /></div>
  </main>
  <Footer locale={locale} />
</Layout>
