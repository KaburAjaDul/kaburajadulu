---
import VolunteerDetailPage from '@/components/community-system/VolunteerDetailPage.astro';
import { LOCALES, type Locale } from '@/i18n/constants';
import { volunteerDirectory, volunteerBySlug } from '@/content/volunteer-content';

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== 'id').flatMap((locale) => volunteerDirectory(locale).people.map((profile) => ({ params: { lang: locale, slug: profile.slug } })));
}

const locale = Astro.params.lang as Locale;
const slug = Astro.params.slug ?? '';
const profile = volunteerBySlug(locale, slug);
---
<VolunteerDetailPage profile={profile} locale={locale} currentPath={`/${locale}/volunteer/${slug}`} />
