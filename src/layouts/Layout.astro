---
import { LOCALES, LOCALE_DIR } from '@/i18n/constants';
import { DISCORD_URL } from '@/constants/urls';
import { translate } from '@/i18n/dictionaries';
import type { Locale } from '@/i18n/constants';
import type { CommunitySection } from '@/content/community-shell';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  gscVerification?: string;
  locale?: Locale;
  currentPath?: string;
  section?: CommunitySection;
}

const {
  title,
  description = 'Temukan peluang untuk bekerja, belajar, atau menjelajahi dunia dengan sumber daya yang bisa ditinjau.',
  canonical,
  gscVerification,
  locale = 'id' as Locale,
  currentPath = Astro.url.pathname,
  section,
} = Astro.props;

const siteUrl = 'https://kaburajadulu.com';
const isStaging = import.meta.env.PUBLIC_DEPLOY_ENV === 'staging';
const dir = LOCALE_DIR[locale] ?? 'ltr';
const localePrefix = /^\/(id|en|ja|zh-cn|zh-tw|ko|es|ar|nl|it|de|fr|sv)(?=\/|$)/;
const unprefixedPath = currentPath.replace(localePrefix, '').replace(/\/+$/, '') || '/';
const localizedPath = (targetLocale: Locale): string => {
  const suffix = unprefixedPath === '/' ? '/' : unprefixedPath;
  return targetLocale === 'id' ? suffix : `/${targetLocale}${suffix}`;
};
const canonicalURL = canonical || `${siteUrl}${localizedPath(locale)}`;
const hreflangLinks = LOCALES.map((loc) => ({
  locale: loc === 'zh-cn' ? 'zh-CN' : loc === 'zh-tw' ? 'zh-TW' : loc,
  url: `${siteUrl}${localizedPath(loc)}`,
})).concat([{ locale: 'x-default', url: `${siteUrl}${localizedPath('en')}` }]);
const pageType = section ? 'CollectionPage' : 'WebPage';
const skipLabel = translate(locale, 'a11y.skip_to_content');
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={isStaging ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {!isStaging && <link rel="canonical" href={canonicalURL} />}
    <title>{title}</title>
    {!isStaging && hreflangLinks.map(({ locale: alternateLocale, url }) => <link rel="alternate" hreflang={alternateLocale} href={url} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Caveat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!isStaging && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:type" content="website" />
    {!isStaging && <meta property="og:image" content={`${siteUrl}/images/og-image.png`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {!isStaging && <meta name="twitter:image" content={`${siteUrl}/images/og-image.png`} />}
    {!isStaging && <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': pageType,
        name: title,
        description,
        url: canonicalURL,
        isPartOf: { '@type': 'WebSite', name: 'KaburAjaDulu', url: siteUrl },
      })} />}
    {!isStaging && <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'KaburAjaDulu',
        url: siteUrl,
        sameAs: [DISCORD_URL],
      })} />}
    <script is:inline define:vars={{ locale }}>
      (function () {
        var country = window.navigator.language.split('-')[1] || '';
        var localeMap = {
          ID: 'id', PH: 'en', SG: 'en', MY: 'en', TH: 'en', VN: 'en', BN: 'en',
          US: 'en', GB: 'en', AU: 'en', NZ: 'en', CA: 'en', IE: 'en', ZA: 'en', KE: 'en', NG: 'en', GH: 'en', TZ: 'en',
          JP: 'ja', CN: 'zh-cn', MO: 'zh-cn', TW: 'zh-tw', HK: 'zh-tw', KR: 'ko',
          ES: 'es', MX: 'es', AR: 'es', CO: 'es', PE: 'es', CL: 'es', VE: 'es', EC: 'es',
          SA: 'ar', AE: 'ar', EG: 'ar', MA: 'ar', KW: 'ar', QA: 'ar', BH: 'ar', OM: 'ar', JO: 'ar', DZ: 'ar', TN: 'ar', LY: 'ar', SD: 'ar', IQ: 'ar', LB: 'ar', SY: 'ar',
          NL: 'nl', BE: 'nl', IT: 'it', DE: 'de', AT: 'de', CH: 'de', LI: 'de', LU: 'de', FR: 'fr', MC: 'fr',
          SE: 'sv', NO: 'sv', DK: 'sv', FI: 'sv', IS: 'sv'
        };
        var detected = localeMap[country];
        if (detected && detected !== locale) document.documentElement.setAttribute('data-detected-locale', detected);
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <slot />
  </body>
</html>
