---
import { LOCALES, LOCALE_DIR } from '@/i18n/constants';
import { DISCORD_URL } from '@/constants/urls';
import type { Locale } from '@/i18n/constants';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  gscVerification?: string;
  locale?: Locale;
  currentPath?: string;
  robots?: string;
  isPreview?: boolean;
}

const {
  title,
  description: descriptionProp,
  canonical,
  gscVerification,
  locale = 'id' as Locale,
  currentPath = Astro.url.pathname,
  robots: robotsProp,
  isPreview = false,
} = Astro.props;

const siteUrl = 'https://kaburajadulu.com';
const dir = LOCALE_DIR[locale] ?? 'ltr';
const stagingFixturesEnabled = import.meta.env.PUBLIC_STAGING_FIXTURES === 'true';
const stagingBuildEnabled = import.meta.env.PUBLIC_STAGING_BUILD === 'true';
const suppressDiscoveryLinks = isPreview || stagingFixturesEnabled || stagingBuildEnabled;
const robots = robotsProp ?? (stagingFixturesEnabled || stagingBuildEnabled ? 'noindex, nofollow' : 'index, follow');
const description = descriptionProp ?? (locale === 'id'
  ? 'Temukan sumber, program, dan percakapan komunitas untuk orang Indonesia yang sedang menjajaki studi dan kerja di luar negeri.'
  : 'Find sources, programs, and community conversations for Indonesians exploring study and work abroad.');
const organizationDescription = locale === 'id'
  ? 'Komunitas orang Indonesia yang saling berbagi sumber dan pengalaman tentang studi, kerja, dan hidup di luar negeri.'
  : 'A community where Indonesians share sources and lived experience about studying, working, and living abroad.';
const websiteDescription = locale === 'id'
  ? 'Sumber, program, dan percakapan komunitas untuk menjajaki langkah ke luar negeri.'
  : 'Sources, programs, and community conversations for exploring life abroad.';
const keywords = locale === 'id'
  ? 'studi luar negeri, kerja luar negeri, beasiswa, kelas bahasa, komunitas Indonesia'
  : 'study abroad, work abroad, scholarships, language clubs, Indonesian community';
const withTrailingSlash = (value: string): string => {
  const url = new URL(value, siteUrl);
  if (!url.pathname.endsWith('/')) url.pathname = `${url.pathname}/`;
  return url.toString();
};
const canonicalURL = withTrailingSlash(canonical || currentPath);

const pathSegments = currentPath.split('/').filter(Boolean);
if (pathSegments[0] && LOCALES.includes(pathSegments[0] as Locale)) pathSegments.shift();
const pagePath = pathSegments.length > 0 ? `/${pathSegments.join('/')}` : '/';

const hreflangLinks = LOCALES.map((loc) => {
  const prefix = loc === 'id' ? '' : `/${loc}`;
  const locPath = pagePath === '/' ? `${prefix}/` : `${prefix}${pagePath}/`;
  return {
    locale: loc === 'zh-cn' ? 'zh-CN' : loc === 'zh-tw' ? 'zh-TW' : loc,
    url: `${siteUrl}${locPath}`,
  };
}).concat([{ locale: 'x-default', url: withTrailingSlash(`/en${pagePath}`) }]);
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <!-- Hreflang tags for i18n SEO -->
    {!suppressDiscoveryLinks && hreflangLinks.map(({ locale: loc, url }) => (
      <link rel="alternate" hreflang={loc} href={url} />
    ))}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,300..900&family=Caveat:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />

    <!-- Meta tags -->
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Tim KaburAjaDulu" />
    <meta name="robots" content={robots} />

    <!-- Google Search Console Verification -->
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <!-- Canonical URL -->
    {!suppressDiscoveryLinks && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/images/og-image.png`} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/og-image.png`} />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "KaburAjaDulu",
      "description": organizationDescription,
      "url": siteUrl,
      "logo": `${siteUrl}/icon.svg`,
      "foundingDate": "2024",
      "founder": { "@type": "Organization", "name": "Tim KaburAjaDulu" },
      "sameAs": [DISCORD_URL],
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${siteUrl}/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "KaburAjaDulu",
      "description": websiteDescription,
      "url": siteUrl
    })} />

    <!-- Geo-detection script: reads CF-IPCountry header client-side -->
    <script is:inline define:vars={{ locale }}>
      (function() {
        var country = window.navigator.language.split('-')[1] || '';
        // CF-IPCountry is set by Cloudflare as a request header; accessible client-side
        // in Cloudflare Workers environments. Fallback to navigator.language.
        var localeMap = {
          'ID':'id','PH':'en','SG':'en','MY':'en','TH':'en','VN':'en','BN':'en',
          'US':'en','GB':'en','AU':'en','NZ':'en','CA':'en','IE':'en','ZA':'en',
          'KE':'en','NG':'en','GH':'en','TZ':'en',
          'JP':'ja','CN':'zh-cn','MO':'zh-cn',
          'TW':'zh-tw','HK':'zh-tw',
          'KR':'ko',
          'ES':'es','MX':'es','AR':'es','CO':'es','PE':'es','CL':'es','VE':'es','EC':'es',
          'SA':'ar','AE':'ar','EG':'ar','MA':'ar','KW':'ar','QA':'ar','BH':'ar',
          'OM':'ar','JO':'ar','DZ':'ar','TN':'ar','LY':'ar','SD':'ar','IQ':'ar',
          'LB':'ar','SY':'ar',
          'NL':'nl','BE':'nl',
          'IT':'it',
          'DE':'de','AT':'de','CH':'de','LI':'de','LU':'de',
          'FR':'fr','MC':'fr',
          'SE':'sv','NO':'sv','DK':'sv','FI':'sv','IS':'sv'
        };
        var detected = localeMap[country];
        if (detected && detected !== locale) {
          document.documentElement.setAttribute('data-detected-locale', detected);
        }
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Archivo', sans-serif;
    --font-editorial: 'Newsreader', Georgia, serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
    --font-caveat: 'Caveat', cursive;
  }

  body {
    font-family: var(--font-sans);
  }

  .font-caveat {
    font-family: var(--font-caveat);
  }

  /* RTL Support */
  [dir="rtl"] {
    direction: rtl;
    text-align: right;
  }

  [dir="rtl"] .navbar {
    flex-direction: row-reverse;
  }

  [dir="rtl"] .nav-links {
    flex-direction: row-reverse;
  }

  [dir="rtl"] .flex.items-center {
    flex-direction: row-reverse;
  }

  [dir="rtl"] .ml-auto {
    margin-left: 0;
    margin-right: auto;
  }

  [dir="rtl"] .mr-auto {
    margin-right: 0;
    margin-left: auto;
  }
</style>
