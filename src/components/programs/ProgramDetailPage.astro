---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer';
import DemoBanner from '@/components/community-system/DemoBanner.astro';
import StatePanel from '@/components/community-system/StatePanel.astro';
import { DISCORD_URL, localizedPath } from '@/content/community-site';
import { STAGING_FIXTURES_ENABLED } from '@/content/staging-fixtures';
import { programDisplayState, type PublicProgram } from '@/content/public-content';
import type { Locale } from '@/i18n/constants';
import '@/styles/global.css';

interface Props {
  locale: Locale;
  currentPath: string;
  program?: PublicProgram | null;
}

const { locale, currentPath, program } = Astro.props;
const isIndonesian = locale === 'id';
const contentLanguage = isIndonesian ? 'id' : 'en';
const fallbackText = !['id', 'en'].includes(locale)
  ? 'This community surface is available in English while a full translation is prepared.'
  : null;
const href = (path: string): string => localizedPath(locale, path);
const title = program
  ? `${program.title} — KaburAjaDulu`
  : isIndonesian ? 'Program tidak ditemukan — KaburAjaDulu' : 'Program not found — KaburAjaDulu';
const description = program?.summary ?? (isIndonesian ? 'Program ini belum memiliki catatan publik.' : 'This program has no public record.');
const reviewedLabel = program
  ? new Intl.DateTimeFormat(isIndonesian ? 'id-ID' : 'en-GB', {
      dateStyle: 'medium',
      timeZone: 'Asia/Jakarta',
    }).format(new Date(program.updatedAt))
  : null;
const publicSource = program?.publicProvenance[0];
const displayState = program ? programDisplayState(program) : null;
const availabilityLabels = {
  active: isIndonesian ? 'Aktif' : 'Active',
  needs_confirmation: isIndonesian ? 'Perlu konfirmasi terbaru' : 'Latest confirmation required',
  archived: isIndonesian ? 'Diarsipkan' : 'Archived',
};
const freshnessLabels = {
  current: isIndonesian ? 'Terkini' : 'Current',
  aging: isIndonesian ? 'Segera ditinjau ulang' : 'Review due soon',
  stale: isIndonesian ? 'Perlu ditinjau ulang' : 'Review overdue',
  unknown: isIndonesian ? 'Belum diketahui' : 'Unknown',
};
---

<Layout title={title} description={description} canonical={`https://kaburajadulu.com${currentPath}`} locale={locale} currentPath={currentPath} robots={STAGING_FIXTURES_ENABLED ? 'noindex, nofollow' : undefined}>
  <Navbar client:only="react" locale={locale} currentPath={currentPath} />
  <main id="main-content" class="kad-page kad-page--task" lang={contentLanguage} data-page-family="program-detail" data-requested-locale={locale} data-fixtures={STAGING_FIXTURES_ENABLED ? 'enabled' : 'disabled'}>
    <div class="kad-container">
      {fallbackText && <p class="kad-translation-notice" lang="en" role="status">{fallbackText}</p>}
      <DemoBanner locale={locale} />

      {program ? (
        <>
          <nav class="kad-breadcrumb" aria-label={isIndonesian ? 'Jejak halaman' : 'Breadcrumb'}>
            <a href={href('/programs')}>{isIndonesian ? 'Program' : 'Programs'}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{program.title}</span>
          </nav>

          <header class="kad-program-detail-intro" aria-labelledby="program-title">
            <div>
              <p class="kad-eyebrow">{program.category}</p>
              <h1 id="program-title">{program.title}</h1>
              <p class="kad-program-detail-intro__summary">{program.summary}</p>
              <a class="kad-button kad-button--primary kad-program-detail-intro__action" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{isIndonesian ? 'Konfirmasi di Discord' : 'Confirm on Discord'}</a>
            </div>
            <dl class="kad-program-record-meta">
              <div>
                <dt>{isIndonesian ? 'Ketersediaan' : 'Availability'}</dt>
                <dd data-program-availability={program.archiveState} data-program-display-state={displayState ?? undefined}>{availabilityLabels[program.archiveState]}</dd>
              </div>
              <div>
                <dt>{isIndonesian ? 'Terakhir ditinjau' : 'Last reviewed'}</dt>
                <dd>{reviewedLabel}</dd>
              </div>
              <div>
                <dt>{isIndonesian ? 'Status data' : 'Data status'}</dt>
                <dd data-freshness={program.freshness}>{freshnessLabels[program.freshness]}</dd>
              </div>
              <div>
                <dt>{isIndonesian ? 'Revisi publik' : 'Public revision'}</dt>
                <dd>{program.revision}</dd>
              </div>
            </dl>
          </header>

          <section class="kad-program-evidence" aria-label={isIndonesian ? 'Status informasi program' : 'Program information status'}>
            <article>
              <p class="kad-eyebrow">{isIndonesian ? 'Dari sumber publik' : 'From the public source'}</p>
              <h2>{isIndonesian ? 'Yang sudah diketahui' : 'What is known'}</h2>
              <ul class="kad-check-list">
                {program.known.map((fact) => <li>{fact}</li>)}
              </ul>
              {publicSource?.url && <a class="kad-source-link" href={publicSource.url} target="_blank" rel="noopener noreferrer">{publicSource.label} <span aria-hidden="true">↗</span></a>}
            </article>
            <article>
              <p class="kad-eyebrow">{isIndonesian ? 'Sebelum ikut' : 'Before joining'}</p>
              <h2>{isIndonesian ? 'Yang perlu dikonfirmasi' : 'What to confirm'}</h2>
              <ul class="kad-check-list">
                {program.needsConfirmation.map((item) => <li>{item}</li>)}
              </ul>
              <p class="kad-program-confirmation-note">{isIndonesian ? 'Gunakan tombol konfirmasi di atas untuk menanyakan status terbaru.' : 'Use the confirmation action above to ask for the latest status.'}</p>
            </article>
          </section>

          {program.media.length > 0 && (
            <section class="kad-program-documentation" aria-labelledby="program-documentation-title">
              <div class="kad-program-documentation__heading">
                <h2 id="program-documentation-title">{isIndonesian ? 'Dokumentasi pengumuman' : 'Announcement documentation'}</h2>
                <p>{isIndonesian ? 'Media ini mendokumentasikan sumber publik, bukan menjamin jadwal masih aktif.' : 'This media documents a public source; it does not guarantee the schedule is still active.'}</p>
              </div>
              <div class:list={['kad-program-gallery', program.media.length === 1 && 'kad-program-gallery--single']}>
                {program.media.map((media) => (
                  <figure class="kad-program-figure">
                    <div class="kad-program-figure__media">
                      <img data-program-poster src={media.url} alt={media.alt} width={media.width ?? undefined} height={media.height ?? undefined} loading="lazy" decoding="async" />
                      <p class="kad-media-fallback" hidden>{isIndonesian ? 'Poster gagal dimuat. Buka sumber publik.' : 'The poster failed to load. Open the public source.'}</p>
                    </div>
                    <figcaption>
                      <span>{media.caption}</span>
                      {publicSource?.url && <a href={publicSource.url} target="_blank" rel="noopener noreferrer">{isIndonesian ? 'Buka sumber publik' : 'Open public source'} <span aria-hidden="true">↗</span></a>}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )}
        </>
      ) : (
        <section class="kad-program-missing">
          <StatePanel state="not-published" locale={locale} statusLabel={isIndonesian ? 'Belum dipublikasikan' : 'Not published'} title={isIndonesian ? 'Program tidak ditemukan.' : 'Program not found.'} description={description} />
          <a class="kad-text-link" href={href('/programs')}>{isIndonesian ? 'Kembali ke direktori program' : 'Back to the program directory'}</a>
        </section>
      )}
    </div>
  </main>
  <Footer client:only="react" locale={locale} />
</Layout>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-program-poster]').forEach((image) => {
    const showFallback = () => {
      image.hidden = true;
      const fallback = image.nextElementSibling;
      if (fallback instanceof HTMLElement) fallback.hidden = false;
    };
    image.addEventListener('error', showFallback, { once: true });
    if (image.complete && image.naturalWidth === 0) showFallback();
  });
</script>
