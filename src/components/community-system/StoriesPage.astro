---
import type { Locale } from '@/i18n/constants';
import { DISCORD_URL } from '@/content/community-site';
import { activeStagingPublishedRecords, fixtureText, stagingFixturesEnabled, stagingStoryBySlug } from '@/content/staging-fixtures';
import { storyReferencesFor } from '@/content/community-information-content';
import '@/styles/community-information.css';

interface Props { locale: Locale; href: (path: string) => string; slug?: string; }
const { locale, href, slug } = Astro.props;
const isEnglish = locale !== 'id';
const fixturesEnabled = stagingFixturesEnabled();
const story = slug ? stagingStoryBySlug(slug) : undefined;
const stories = activeStagingPublishedRecords().filter((record) => record.recordType === 'story' && record.slug);
const date = (value: string) => new Intl.DateTimeFormat(isEnglish ? 'en-GB' : 'id-ID', { dateStyle: 'long', timeZone: 'Asia/Jakarta' }).format(new Date(`${value}T12:00:00+07:00`));
const referenceHref = (referenceHref: string) => href(referenceHref.replace(/\/$/, ''));
const statusLabel = (state: string) => state === 'completed' ? (isEnglish ? 'Reviewed' : 'Ditinjau') : (isEnglish ? 'Preview' : 'Pratinjau');
---

<div class="kad-story-information" data-story-surface={slug ? 'detail' : 'index'}>
  {slug && story ? <>
    <header class="kad-story-information__header" data-page-header="story-record" aria-labelledby="story-title">
      <div><p class="kad-story-information__eyebrow">{isEnglish ? 'Community documentation' : 'Dokumentasi komunitas'}</p><h1 id="story-title">{fixtureText(story.title, locale)}</h1><p>{fixtureText(story.summary, locale)}</p></div>
      <p class="kad-community-information__header-note">{isEnglish ? 'This note documents context. It does not replace the Agenda or contribution ledger.' : 'Catatan ini mendokumentasikan konteks. Ia tidak menggantikan Agenda atau buku kontribusi.'}</p>
    </header>
    <section class="kad-story-information__section kad-story-information__detail" aria-labelledby="story-body-title">
      <div class="kad-story-information__section-heading"><div><p class="kad-story-information__eyebrow">{statusLabel(story.state)} · {date(story.publishedDate)}</p><h2 id="story-body-title">{isEnglish ? 'What happened and what was learned.' : 'Apa yang terjadi dan apa yang dipelajari.'}</h2></div></div>
      <div class="kad-story-information__detail-body">{story.body?.map((paragraph) => <p>{fixtureText(paragraph, locale)}</p>)}</div>
      {fixturesEnabled && <div class="kad-story-information__references" aria-label={isEnglish ? 'Related records' : 'Rekaman terkait'}>{storyReferencesFor(story.id).map((reference) => <a class="kad-story-information__reference" href={referenceHref(reference.href)}>{fixtureText(reference.label, locale)} →</a>)}</div>}
      <footer class="kad-story-information__detail-footer"><span>{fixtureText(story.sourceLabel, locale)}</span><a href={href('/stories')}>{isEnglish ? 'Back to stories' : 'Kembali ke cerita'} →</a></footer>
    </section>
  </> : slug ? <>
    <header class="kad-story-information__header" data-page-header="story-record" aria-labelledby="story-not-found-title">
      <div><p class="kad-story-information__eyebrow">{isEnglish ? 'Community documentation' : 'Dokumentasi komunitas'}</p><h1 id="story-not-found-title">{isEnglish ? 'Story not published.' : 'Cerita belum dipublikasikan.'}</h1><p>{isEnglish ? 'This record has not passed source, consent, and editorial review.' : 'Rekaman ini belum melewati tinjauan sumber, izin, dan editorial.'}</p></div>
      <p class="kad-community-information__header-note">Evidence Placeholder</p>
    </header>
    <section class="kad-story-information__section" aria-labelledby="story-not-found-body"><div class="kad-story-information__empty" data-state="empty"><h2 id="story-not-found-body">{isEnglish ? 'No public story record is available.' : 'Belum ada rekaman cerita publik.'}</h2><p>{isEnglish ? 'Return to the archive or share context for review.' : 'Kembali ke arsip atau bagikan konteks untuk ditinjau.'}</p><a href={href('/stories')}>{isEnglish ? 'Back to stories' : 'Kembali ke cerita'} →</a></div></section>
  </> : <>
    <header class="kad-story-information__header" data-page-header="story-index" aria-labelledby="stories-title">
      <div><p class="kad-story-information__eyebrow">{isEnglish ? 'Community archive' : 'Arsip komunitas'}</p><h1 id="stories-title">{isEnglish ? 'Stories with context.' : 'Cerita dengan konteks.'}</h1><p>{isEnglish ? 'Documentation turns an activity into a record people can understand, revisit, and correct.' : 'Dokumentasi mengubah aktivitas menjadi rekaman yang dapat dipahami, ditinjau ulang, dan dikoreksi.'}</p></div>
      <p class="kad-community-information__header-note">{fixturesEnabled ? (isEnglish ? 'Staging preview: fictional stories and references.' : 'Pratinjau staging: cerita dan referensi fiktif.') : (isEnglish ? 'Stories publish only after editorial and privacy review.' : 'Cerita hanya terbit setelah tinjauan editorial dan privasi.')}</p>
    </header>
    <section class="kad-story-information__section" aria-labelledby="stories-list-title">
      <div class="kad-story-information__section-heading"><div><p class="kad-story-information__eyebrow">01 · {isEnglish ? 'Documentation' : 'Dokumentasi'}</p><h2 id="stories-list-title">{isEnglish ? 'A record, not a headline.' : 'Rekaman, bukan sekadar judul.'}</h2></div><p>{isEnglish ? 'Stories can point to program, session, event, and contributor records when those links are available.' : 'Cerita dapat menunjuk ke rekaman program, sesi, acara, dan kontributor jika tautannya tersedia.'}</p></div>
      {fixturesEnabled && stories.length > 0 ? <div class="kad-story-information__list">{stories.map((item) => <article class="kad-story-information__item" data-fixture-id={item.id} data-fixture-state={item.state}><div class="kad-story-information__item-meta"><span>{statusLabel(item.state)}</span><time datetime={item.publishedDate}>{date(item.publishedDate)}</time></div><h3><a href={href(`/stories/${item.slug}`)}>{fixtureText(item.title, locale)}</a></h3><p>{fixtureText(item.summary, locale)}</p>{storyReferencesFor(item.id).length > 0 && <div class="kad-story-information__references">{storyReferencesFor(item.id).map((reference) => <a class="kad-story-information__reference" href={referenceHref(reference.href)}>{fixtureText(reference.label, locale)} →</a>)}</div>}</article>)}</div> : <div class="kad-story-information__empty" data-state="empty"><strong>{isEnglish ? 'Evidence Placeholder' : 'Evidence Placeholder'}</strong><p>{isEnglish ? 'No public story is ready until source, consent, and editorial review are complete.' : 'Belum ada cerita publik sampai sumber, izin, dan tinjauan editorial selesai.'}</p><a href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{isEnglish ? 'Share context for review' : 'Bagikan konteks untuk ditinjau'} ↗</a></div>}
    </section>
  </>}
</div>
