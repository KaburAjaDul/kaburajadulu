---
import Layout from '@/layouts/Layout.astro';
import type { Locale } from '@/i18n/constants';
import { DISCORD_URL, INSTAGRAM_URL, PROGRAMS, X_URL, localizedPath, pageTitle, programBySlug, communityCopy, localizedProgram } from '@/content/community-site';
import { STAGING_FIXTURES_ENABLED, activeStagingEvents, fixtureText, stagingEventById, stagingSessionByProgramId, STAGING_ATTRIBUTION, STAGING_CONTRIBUTIONS, STAGING_METRICS, STAGING_PUBLISHED_RECORDS, STAGING_TEAMS, STAGING_VOLUNTEERS } from '@/content/staging-fixtures';
import Navbar from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer';
import TaskHeader from '@/components/community-system/TaskHeader.astro';
import DemoBanner from '@/components/community-system/DemoBanner.astro';
import EventScheduleCard from '@/components/community-system/EventScheduleCard.astro';
import VolunteerProfileCard from '@/components/community-system/VolunteerProfileCard.astro';
import MetricCard from '@/components/community-system/MetricCard.astro';
import StatePanel from '@/components/community-system/StatePanel.astro';
import StatusBadge from '@/components/community-system/StatusBadge.astro';
import SessionPreview from '@/components/community-system/SessionPreview.astro';
import AttributionConsentCard from '@/components/community-system/AttributionConsentCard.astro';
import '@/styles/global.css';

interface Props { kind: import('@/content/community-site').CommunityPageKind; locale: Locale; currentPath: string; slug?: string; id?: string; }
const { kind, locale, currentPath, slug, id } = Astro.props;
const program = slug ? programBySlug(slug) : undefined;
const localized = program ? localizedProgram(locale, program) : undefined;
const copy = communityCopy(locale, kind);
const title = pageTitle(kind, localized ?? program, locale);
const description = copy.description;
const href = (path: string): string => localizedPath(locale, path);
const stagingEvents = activeStagingEvents();
const event = id ? stagingEventById(id) : undefined;
const isEnglish = locale !== 'id';
const fallbackText = !['id', 'en'].includes(locale)
  ? 'This community surface is available in English while a full translation is prepared.'
  : null;
const contentLanguage = locale === 'id' ? 'id' : 'en';
---

<Layout title={title} description={description} canonical={`https://kaburajadulu.com${currentPath}`} locale={locale} currentPath={currentPath} robots={STAGING_FIXTURES_ENABLED ? 'noindex, nofollow' : undefined}>
  <Navbar client:only="react" locale={locale} currentPath={currentPath} />
  <main id="main-content" class="kad-page" lang={contentLanguage} data-requested-locale={locale} data-fixtures={STAGING_FIXTURES_ENABLED ? 'enabled' : 'disabled'}>
    <div class="kad-container">
      {fallbackText && <p class="kad-translation-notice" lang="en" role="status">{fallbackText}</p>}
      <DemoBanner locale={locale} />

      {kind === 'community' && (
        <>
          <section class="kad-page-hero" aria-labelledby="page-title" data-page-header="orientation">
            <p class="kad-eyebrow">{copy.eyebrow}</p>
            <div class="kad-hero-grid"><h1 id="page-title">{copy.title}</h1><div><p class="kad-lede">{copy.description}</p><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></div></div>
          </section>
          <section class="kad-section" aria-labelledby="journey-title"><div class="kad-section-heading"><p class="kad-kicker">01 · {isEnglish ? 'Participation path' : 'Jalur partisipasi'}</p><h2 id="journey-title">{isEnglish ? 'Choose your entry point.' : 'Pilih pintu masukmu.'}</h2></div><div class="kad-grid kad-grid--three">
            {[isEnglish ? ['Find a space', 'Start with study, work, language, or everyday life abroad.'] : ['Temukan ruang', 'Mulai dari kebutuhan studi, kerja, bahasa, atau hidup sehari-hari di luar negeri.'], isEnglish ? ['Follow a rhythm', 'Find clubs and sessions with public sources and readable status.'] : ['Ikuti rutinitas', 'Telusuri klub dan sesi yang punya sumber publik serta status yang bisa dibaca.'], isEnglish ? ['Contribute back', 'Help make learning spaces and documentation easier to access.'] : ['Berkontribusi kembali', 'Bantu membuat ruang belajar dan dokumentasi lebih mudah diakses.']].map(([heading, text], index) => <article class="kad-card kad-journey-card"><span class="kad-marker">0{index + 1}</span><h3>{heading}</h3><p>{text}</p></article>)}
          </div></section>
          <section class="kad-section kad-band" aria-labelledby="after-title"><div><p class="kad-kicker">02 · {isEnglish ? 'After joining' : 'Setelah bergabung'}</p><h2 id="after-title">{isEnglish ? 'Conversations still have guardrails.' : 'Percakapan tetap punya pagar.'}</h2></div><ul class="kad-check-list">{(isEnglish ? ['Read room context and rules before joining.', 'Use public links as sources and confirm current schedules in Discord.', 'Respect identity and experience without forcing public attribution.'] : ['Baca konteks dan aturan ruang sebelum ikut berdiskusi.', 'Gunakan tautan publik sebagai sumber; jadwal terbaru dikonfirmasi di Discord.', 'Jaga identitas dan pengalaman orang lain tanpa memaksa atribusi publik.']).map((item) => <li>{item}</li>)}</ul></section>
          <section class="kad-section" aria-labelledby="social-title"><div class="kad-section-heading"><p class="kad-kicker">03 · {isEnglish ? 'Public channels' : 'Kanal publik'}</p><h2 id="social-title">{isEnglish ? 'Follow sources you can inspect.' : 'Ikuti sumber yang bisa kamu periksa.'}</h2></div><div class="kad-grid kad-grid--three"><a class="kad-card kad-source-link" href={X_URL} target="_blank" rel="noopener noreferrer"><strong>X / @KADSocialHub</strong><span>{isEnglish ? 'Public profile and announcements' : 'Profil publik dan sumber pengumuman'}</span></a><a class="kad-card kad-source-link" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer"><strong>Instagram / @kadsocialhub</strong><span>{isEnglish ? 'Visual index and community source' : 'Indeks visual dan sumber komunitas'}</span></a><a class="kad-card kad-source-link" href={DISCORD_URL} target="_blank" rel="noopener noreferrer"><strong>Discord</strong><span>{isEnglish ? 'Conversation and confirmation space' : 'Ruang percakapan dan konfirmasi'}</span></a></div></section>
        </>
      )}

      {kind === 'programs' && (
        <>
          <TaskHeader eyebrow={copy.eyebrow} title={copy.title} summary={copy.description} variant="catalogue" locale={locale} stats={[{ value: String(PROGRAMS.length), label: isEnglish ? 'Public programs' : 'Program publik', state: 'ready' }, { value: '2', label: isEnglish ? 'Categories' : 'Kategori' }, { value: isEnglish ? 'Confirm' : 'Konfirmasi', label: isEnglish ? 'Latest status' : 'Status terbaru', state: 'pending' }]}>
            <a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a>
            <div slot="footer" class="kad-filter-row" aria-label={isEnglish ? 'Program categories' : 'Kategori program'}><a class="kad-pill" href="#all">{isEnglish ? 'All' : 'Semua'}</a><a class="kad-pill" href="#language">{isEnglish ? 'Language clubs' : 'Klub bahasa'}</a><a class="kad-pill" href="#career">{isEnglish ? 'Education and career' : 'Pendidikan & karier'}</a></div>
          </TaskHeader>
          <section class="kad-section" aria-labelledby="programs-title"><div id="all" class="kad-grid kad-grid--two">{PROGRAMS.map((source, index) => { const item = localizedProgram(locale, source); const cover = item.media[0]; const categoryId = source.category === 'Klub bahasa' ? 'language' : 'career'; const firstInCategory = PROGRAMS.findIndex((candidate) => candidate.category === source.category) === index; return <article class="kad-card kad-program-card" id={firstInCategory ? categoryId : undefined} data-program-id={item.slug}>{cover ? <a class="kad-program-card__media" href={href(`/programs/${item.slug}`)}><img data-program-poster src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /><p class="kad-media-fallback" hidden>{isEnglish ? 'Poster failed to load. Open the public source.' : 'Poster gagal dimuat. Buka sumber publik.'}</p></a> : null}<div class="kad-card-top"><span class="kad-pill kad-pill-soft">{item.category}</span><span class="kad-status">{isEnglish ? 'Confirm on Discord' : 'Konfirmasi di Discord'}</span></div><h2><a href={href(`/programs/${item.slug}`)}>{item.title}</a></h2><p>{item.summary}</p><div class="kad-card-actions"><a class="kad-source-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceLabel} ↗</a><a class="kad-text-link" href={href(`/programs/${item.slug}`)}>{copy.actions.detail}</a></div></article>; })}</div><p id="programs-title" class="kad-note">{isEnglish ? 'Posters document public announcements. They are not proof of an active schedule.' : 'Poster mendokumentasikan pengumuman publik, bukan bukti jadwal yang masih aktif.'}</p></section>
          {STAGING_FIXTURES_ENABLED && <section class="kad-section" aria-labelledby="sample-sessions-title"><div class="kad-section-heading"><div><p class="kad-kicker">{copy.states.demo}</p><h2 id="sample-sessions-title">{isEnglish ? 'See how a next-session module would work.' : 'Lihat cara modul jadwal berikutnya bekerja.'}</h2></div><p class="kad-note">{isEnglish ? 'These dates are fictional and exist only to review the staging experience.' : 'Tanggal ini fiktif dan hanya dipakai untuk menilai pengalaman staging.'}</p></div><div class="kad-grid kad-grid--two">{PROGRAMS.map((item) => stagingSessionByProgramId(item.slug)).filter((session) => session !== undefined).map((session) => <SessionPreview session={session} locale={locale} programHref={href(`/programs/${session.programId}`)} />)}</div></section>}
        </>
      )}

      {kind === 'program' && localized && (
        <>
          <TaskHeader eyebrow={`${copy.eyebrow} · ${localized.category}`} title={localized.title} summary={localized.summary} variant="record" locale={locale} stats={[{ value: String(localized.media.length), label: isEnglish ? 'Public posters' : 'Poster publik', state: localized.media.length > 0 ? 'ready' : 'pending' }, { value: localized.category, label: isEnglish ? 'Category' : 'Kategori' }, { value: isEnglish ? 'Confirm' : 'Konfirmasi', label: isEnglish ? 'Availability' : 'Ketersediaan', state: 'pending' }]}><a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></TaskHeader>
          {localized.media.length > 0 && <section class="kad-section kad-documentation" aria-labelledby="documentation-title"><div class:list={['kad-program-gallery', localized.media.length === 1 && 'kad-program-gallery--single']}>{localized.media.map((media) => <figure class="kad-program-figure"><div class="kad-program-figure__media"><img data-program-poster src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" decoding="async" /><p class="kad-media-fallback" hidden>{isEnglish ? 'Poster failed to load. Open the public source.' : 'Poster gagal dimuat. Buka sumber publik.'}</p></div><figcaption><span>{media.caption}</span><a href={media.sourceUrl} target="_blank" rel="noopener noreferrer">{isEnglish ? 'Open public source' : 'Buka sumber publik'} ↗</a></figcaption></figure>)}</div></section>}
          <section class="kad-section" aria-labelledby="known-title"><div class="kad-grid kad-grid--two"><article class="kad-card"><p class="kad-kicker">{isEnglish ? 'Known' : 'Yang sudah diketahui'}</p><h2 id="known-title">{isEnglish ? 'Starts from a source.' : 'Berangkat dari sumber.'}</h2><ul class="kad-check-list">{localized.known.map((fact) => <li>{fact}</li>)}</ul></article><article class="kad-card kad-evidence-pending"><p class="kad-kicker">{isEnglish ? 'Confirm on Discord' : 'Konfirmasi di Discord'}</p><h2>{isEnglish ? 'Next step.' : 'Langkah berikutnya.'}</h2><ul class="kad-check-list">{localized.confirm.map((fact) => <li>{fact}</li>)}</ul><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></article></div></section>
        </>
      )}

      {kind === 'events' && (
        <><TaskHeader eyebrow={copy.eyebrow} title={copy.title} summary={copy.description} variant="operational" locale={locale} stats={[{ value: STAGING_FIXTURES_ENABLED ? String(stagingEvents.length) : '0', label: isEnglish ? 'Events shown' : 'Agenda tampil', state: stagingEvents.length ? 'ready' : 'pending' }, { value: STAGING_FIXTURES_ENABLED ? copy.states.demo : copy.states.empty, label: isEnglish ? 'Dataset' : 'Sumber data', state: STAGING_FIXTURES_ENABLED ? 'ready' : 'pending' }, { value: 'Discord', label: isEnglish ? 'Latest confirmation' : 'Konfirmasi terbaru' }]}><a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></TaskHeader><section class="kad-section" aria-labelledby="event-state-title">{STAGING_FIXTURES_ENABLED ? <div class="kad-grid kad-grid--three">{stagingEvents.map((item) => <EventScheduleCard event={item} locale={locale} href={href(`/events/${item.id}`)} />)}</div> : <div data-event-count="0" data-event-state="empty"><StatePanel state="empty" id="event-state-title" locale={locale} statusLabel={isEnglish ? '0 public events' : '0 agenda publik'} title={isEnglish ? 'No event record has passed publication review.' : 'Belum ada agenda yang lolos pemeriksaan publikasi.'} description={isEnglish ? 'This page stays empty until a dated source and its latest revision are approved.' : 'Halaman ini tetap kosong sampai sumber bertanggal dan revisi terbarunya disetujui.'} /></div>}</section></>
      )}

      {kind === 'event' && (event ? <><TaskHeader eyebrow={copy.eyebrow} title={fixtureText(event.title, locale)} summary={fixtureText(event.summary, locale)} variant="record" locale={locale} stats={[{ value: event.id, label: isEnglish ? 'Fixture ID' : 'ID simulasi' }, { value: event.state, label: isEnglish ? 'State' : 'Status', state: event.state === 'completed' ? 'ready' : 'pending' }, { value: copy.states.demo, label: isEnglish ? 'Data boundary' : 'Batas data', state: 'ready' }]}><a slot="actions" class="kad-button kad-button--outline" href={href('/events')}>{copy.actions.back}</a></TaskHeader><section class="kad-section"><article class="kad-card kad-event-detail" data-fixture-id={event.id} data-fixture-state={event.state}><StatusBadge state={event.state} locale={locale} /><p>{new Intl.DateTimeFormat(isEnglish ? 'en-US' : 'id-ID', { dateStyle: 'full', timeStyle: 'short', timeZone: event.timezone }).format(new Date(event.startsAt))}</p><p>{isEnglish ? 'This deterministic record exists only to test the staging experience.' : 'Rekaman deterministik ini hanya dipakai untuk menguji pengalaman staging.'}</p></article></section></> : <><TaskHeader eyebrow={copy.eyebrow} title={copy.title} summary={copy.description} variant="record" locale={locale} stats={[{ value: id ?? 'unknown', label: isEnglish ? 'Record ID' : 'ID rekaman' }, { value: copy.states.notPublished, label: 'Status', state: 'pending' }, { value: '0', label: isEnglish ? 'Public sources' : 'Sumber publik', state: 'pending' }]}><a slot="actions" class="kad-button kad-button--outline" href={href('/events')}>{copy.actions.back}</a></TaskHeader><section class="kad-section"><StatePanel state="not-published" locale={locale} statusLabel={copy.states.notPublished} title={isEnglish ? 'No public record is available.' : 'Belum ada rekaman publik untuk ditampilkan.'} description={isEnglish ? 'This route is reserved for records approved for publication.' : 'Halaman ini disiapkan untuk rekaman yang telah disetujui.'} /></section></>)}

      {kind === 'volunteer' && (<><TaskHeader eyebrow={copy.eyebrow} title={copy.title} summary={copy.description} variant="operational" locale={locale} stats={[{ value: isEnglish ? '3 months' : '3 bulan', label: isEnglish ? 'One cycle' : 'Satu siklus', state: 'ready' }, { value: '3', label: isEnglish ? 'Work stages' : 'Tahap kerja', state: 'ready' }, { value: STAGING_FIXTURES_ENABLED ? String(STAGING_VOLUNTEERS.length) : '0', label: isEnglish ? 'Profiles shown' : 'Profil tampil', state: STAGING_FIXTURES_ENABLED ? 'ready' : 'pending' }]}><a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></TaskHeader><section class="kad-section" aria-labelledby="cycle-title"><div class="kad-cycle" id="cycle-title">{(isEnglish ? [['Intake', 'Turn a need into a clear piece of work.'], ['Program work', 'Finish one useful step with the program team.'], ['Handover', 'Leave decisions and context for the next cycle.']] : [['Penerimaan', 'Ubah kebutuhan menjadi lingkup kerja yang jelas.'], ['Kerja program', 'Tuntaskan satu langkah berguna bersama tim program.'], ['Serah terima', 'Tinggalkan keputusan dan konteks untuk siklus berikutnya.']]).map(([heading, text], index) => <article class="kad-card"><span class="kad-marker">0{index + 1}</span><h2>{heading}</h2><p>{text}</p></article>)}</div></section>{STAGING_FIXTURES_ENABLED ? <><section class="kad-section" aria-labelledby="demo-structure-title"><div class="kad-section-heading"><div><p class="kad-kicker">{copy.states.demo}</p><h2 id="demo-structure-title">{isEnglish ? 'A sample structure built around the work.' : 'Contoh struktur yang mengikuti kebutuhan kerja.'}</h2></div><p class="kad-note">{isEnglish ? 'These are fictional teams, not the current KAD organization chart.' : 'Semua tim ini fiktif, bukan bagan organisasi KAD saat ini.'}</p></div><div class="kad-grid kad-grid--three">{STAGING_TEAMS.map((team) => <article class="kad-card" data-fixture-id={team.id} data-fixture-state={team.state}><StatusBadge state={team.state} locale={locale} /><h3>{fixtureText(team.name, locale)}</h3><p>{fixtureText(team.purpose, locale)}</p><small>{fixtureText(team.handoff, locale)}</small></article>)}</div></section><section class="kad-section" aria-labelledby="demo-profiles-title"><div class="kad-section-heading"><div><p class="kad-kicker">{copy.states.demo}</p><h2 id="demo-profiles-title">{isEnglish ? 'Sample volunteer profiles with explicit attribution.' : 'Profil relawan contoh dengan atribusi yang jelas.'}</h2></div></div><div class="kad-grid kad-grid--three">{STAGING_VOLUNTEERS.map((profile) => <VolunteerProfileCard profile={profile} locale={locale} />)}</div></section></> : <section class="kad-section"><StatePanel state="pending" locale={locale} statusLabel={copy.states.pending} title={isEnglish ? 'Volunteer profiles require explicit permission.' : 'Profil relawan membutuhkan izin yang jelas.'} description={isEnglish ? 'The public site never invents an identity.' : 'Situs publik tidak pernah mengarang identitas.'} /></section>}</>)}

      {kind === 'stories' && (<><TaskHeader eyebrow={copy.eyebrow} title={copy.title} summary={copy.description} variant="evidence" locale={locale} stats={[{ value: STAGING_FIXTURES_ENABLED ? String(STAGING_PUBLISHED_RECORDS.filter((r) => r.recordType === 'story').length) : '0', label: isEnglish ? 'Stories shown' : 'Cerita tampil', state: STAGING_FIXTURES_ENABLED ? 'ready' : 'pending' }, { value: isEnglish ? 'Required' : 'Wajib', label: isEnglish ? 'Editorial approval' : 'Persetujuan editorial', state: 'pending' }, { value: isEnglish ? 'Opt-in' : 'Dengan izin', label: isEnglish ? 'Attribution' : 'Atribusi' }]}><a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></TaskHeader><section class="kad-section">{STAGING_FIXTURES_ENABLED ? <div class="kad-grid kad-grid--two">{STAGING_PUBLISHED_RECORDS.filter((record) => record.recordType === 'story').map((record) => <article class="kad-card" data-fixture-id={record.id} data-fixture-state={record.state}><StatusBadge state={record.state} locale={locale} /><h2>{fixtureText(record.title, locale)}</h2><p>{copy.states.demo}</p></article>)}</div> : <StatePanel state="pending" locale={locale} statusLabel={copy.states.pending} title={copy.states.empty} description={isEnglish ? 'A story publishes only after editorial approval and attribution permission.' : 'Cerita hanya terbit setelah persetujuan editorial dan izin atribusi.'} />}</section></>)}

      {kind === 'impact' && (<><TaskHeader eyebrow={copy.eyebrow} title={copy.title} summary={copy.description} variant="evidence" locale={locale} stats={[{ value: STAGING_FIXTURES_ENABLED ? String(STAGING_METRICS.length) : '0', label: isEnglish ? 'Metrics shown' : 'Metrik tampil', state: STAGING_FIXTURES_ENABLED ? 'ready' : 'pending' }, { value: '4', label: isEnglish ? 'Required fields' : 'Data wajib', state: 'ready' }, { value: isEnglish ? 'Required' : 'Wajib', label: isEnglish ? 'Source and period' : 'Sumber dan periode', state: 'pending' }]}><a slot="actions" class="kad-button kad-button--outline" href={href('/support')}>{copy.actions.support}</a></TaskHeader><section class="kad-section"><div class="kad-grid kad-grid--three">{STAGING_FIXTURES_ENABLED ? STAGING_METRICS.map((metric) => <MetricCard metric={metric} locale={locale} />) : <StatePanel state="pending" locale={locale} statusLabel={copy.states.pending} title={isEnglish ? 'Metrics need a source and period.' : 'Metrik membutuhkan sumber dan periode.'} description={copy.description} />}</div></section></>)}

      {kind === 'credits' && (
        <>
          <TaskHeader eyebrow={copy.eyebrow} title={copy.title} summary={copy.description} variant="evidence" locale={locale} stats={[{ value: STAGING_FIXTURES_ENABLED ? String(STAGING_CONTRIBUTIONS.length) : '0', label: isEnglish ? 'Contributions shown' : 'Kontribusi tampil', state: STAGING_FIXTURES_ENABLED ? 'ready' : 'pending' }, { value: isEnglish ? 'Anonymous' : 'Anonim', label: isEnglish ? 'Default attribution' : 'Atribusi bawaan', state: 'ready' }, { value: isEnglish ? 'Required' : 'Wajib', label: isEnglish ? 'Permission' : 'Izin tampil', state: 'pending' }]}>
            <a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a>
          </TaskHeader>
          <section class="kad-section">
            {STAGING_FIXTURES_ENABLED ? (
              <>
                <div class="kad-section-heading">
                  <div>
                    <p class="kad-kicker">{copy.states.demo}</p>
                    <h2>{isEnglish ? 'Contribution records' : 'Rekaman kontribusi'}</h2>
                  </div>
                </div>
                <div class="kad-grid kad-grid--three">
                  {STAGING_CONTRIBUTIONS.map((item) => <article class="kad-card" data-fixture-id={item.id} data-fixture-state={item.state}><StatusBadge state={item.state} locale={locale} /><h2>{fixtureText(item.area, locale)}</h2><p>{fixtureText(item.summary, locale)}</p><small>{fixtureText(item.contributor, locale)} · {copy.states.demo}</small></article>)}
                </div>
                <div class="kad-section-heading kad-section-heading--nested">
                  <div>
                    <p class="kad-kicker">{isEnglish ? 'Consent states' : 'Status izin'}</p>
                    <h2>{isEnglish ? 'Attribution stays within the recorded scope.' : 'Atribusi tetap mengikuti ruang lingkup izin.'}</h2>
                  </div>
                  <p class="kad-note">{isEnglish ? 'These fictional records exercise named, anonymous, and revoked states.' : 'Rekaman fiktif ini menguji status bernama, anonim, dan dicabut.'}</p>
                </div>
                <div class="kad-grid kad-grid--three">
                  {STAGING_ATTRIBUTION.map((consent) => <AttributionConsentCard consent={consent} locale={locale} />)}
                </div>
              </>
            ) : (
              <StatePanel state="pending" locale={locale} statusLabel={isEnglish ? 'Anonymous by default' : 'Anonim secara bawaan'} title={copy.states.empty} description={isEnglish ? 'Credits stay anonymous until explicit permission is recorded.' : 'Kredit tetap anonim sampai izin tampil tercatat.'} />
            )}
          </section>
        </>
      )}

      {kind === 'history' && <><TaskHeader eyebrow={copy.eyebrow} title={copy.title} summary={copy.description} variant="evidence" locale={locale} stats={[{ value: isEnglish ? 'Evidence review' : 'Tinjauan bukti', label: 'Status', state: 'pending' }, { value: '3', label: isEnglish ? 'Publication checks' : 'Syarat publikasi' }, { value: '0', label: isEnglish ? 'Approved milestones' : 'Tonggak disetujui', state: 'pending' }]} /><section class="kad-section"><StatePanel state="pending" locale={locale} statusLabel={isEnglish ? 'Evidence review' : 'Tinjauan bukti'} title={isEnglish ? 'The public timeline is not ready.' : 'Linimasa publik belum siap.'} description={copy.description} /></section></>}
      {kind === 'support' && <><TaskHeader eyebrow={copy.eyebrow} title={copy.title} summary={copy.description} variant="proposal" locale={locale} stats={[{ value: '4', label: isEnglish ? 'Proposed areas' : 'Area usulan', state: 'ready' }, { value: '0', label: isEnglish ? 'Active payments' : 'Pembayaran aktif', state: 'pending' }, { value: isEnglish ? 'Not ready' : 'Belum siap', label: isEnglish ? 'Governance' : 'Tata kelola', state: 'pending' }]} /><section class="kad-section"><div class="kad-grid kad-grid--two">{(isEnglish ? ['Program continuity', 'Documentation infrastructure', 'Volunteer equipment', 'Safety and moderation'] : ['Keberlanjutan program', 'Infrastruktur dokumentasi', 'Peralatan relawan', 'Keselamatan dan moderasi']).map((label) => <article class="kad-card"><StatusBadge state="pending" locale={locale} /><h3>{label}</h3><p>{isEnglish ? 'A proposed area that still needs an owner, boundary, and reporting method.' : 'Area usulan ini masih membutuhkan pemilik, batas penggunaan, dan cara pelaporan.'}</p></article>)}</div></section></>}
      {kind === 'program' && !localized && <section class="kad-section"><StatePanel state="not-published" locale={locale} statusLabel={copy.states.notPublished} title={isEnglish ? 'Program not found.' : 'Program tidak ditemukan.'} description={isEnglish ? 'This program has no public page.' : 'Program ini belum memiliki halaman publik.'} /></section>}
    </div>
  </main>
  <Footer client:only="react" locale={locale} />
</Layout>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-program-poster]').forEach((image) => {
    const showFallback = () => {
      image.hidden = true;
      const fallback = image.nextElementSibling;
      if (fallback instanceof HTMLElement) fallback.hidden = false;
    };
    image.addEventListener('error', showFallback, { once: true });
    if (image.complete && image.naturalWidth === 0) showFallback();
  });
</script>
