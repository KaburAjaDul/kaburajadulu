---
import Layout from '@/layouts/Layout.astro';
import type { Locale } from '@/i18n/constants';
import { DISCORD_URL, INSTAGRAM_URL, PROGRAMS, X_URL, localizedPath, pageTitle, programBySlug } from '@/content/community-site';
import type { CommunityPageKind } from '@/content/community-site';
import Navbar from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer';
import TaskHeader from '@/components/community-system/TaskHeader.astro';
import '@/styles/global.css';

interface Props {
  kind: CommunityPageKind;
  locale: Locale;
  currentPath: string;
  slug?: string;
  id?: string;
}

const { kind, locale, currentPath, slug, id } = Astro.props;
const program = slug ? programBySlug(slug) : undefined;
const title = pageTitle(kind, program);
const description = 'KaburAjaDulu adalah komunitas publik untuk menemukan ritme belajar, program, dan cara berkontribusi dengan status yang jelas.';
const fallbackText = locale === 'id' ? null : 'Konten komunitas ini menggunakan sumber bahasa Indonesia. Struktur, status, dan jalur navigasi tetap tersedia dalam locale pilihanmu.';
const href = (path: string): string => localizedPath(locale, path);
---

<Layout title={title} description={description} canonical={`https://kaburajadulu.com${currentPath}`} locale={locale} currentPath={currentPath}>
  <Navbar client:only="react" locale={locale} currentPath={currentPath} />
  <main id="main-content" class="kad-page">
    <div class="kad-container">
      {fallbackText && <p class="kad-translation-notice" lang="id">{fallbackText}</p>}

      {kind === 'community' && (
        <>
          <section class="kad-page-hero" aria-labelledby="page-title" data-page-header="orientation">
            <p class="kad-eyebrow">Menemukan komunitas</p>
            <div class="kad-hero-grid"><h1 id="page-title">Komunitas bukan cuma server.</h1><div><p class="kad-lede">Temukan pertanyaan yang ingin kamu jawab, ritme belajar yang cocok, lalu percakapan yang terasa berguna.</p><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Gabung ke Discord</a></div></div>
          </section>
          <section class="kad-section" aria-labelledby="journey-title"><div class="kad-section-heading"><p class="kad-kicker">01 · Jalur partisipasi</p><h2 id="journey-title">Pilih pintu masukmu.</h2></div><div class="kad-grid kad-grid--three">
            <article class="kad-card kad-journey-card"><span class="kad-marker">01</span><h3>Temukan ruang</h3><p>Mulai dari kebutuhan studi, kerja, bahasa, atau hidup sehari-hari di luar negeri.</p></article>
            <article class="kad-card kad-journey-card"><span class="kad-marker">02</span><h3>Ikuti rutinitas</h3><p>Telusuri klub dan sesi yang punya sumber publik serta status yang bisa dibaca.</p></article>
            <article class="kad-card kad-journey-card"><span class="kad-marker">03</span><h3>Berkontribusi kembali</h3><p>Saat siap, bantu membuat ruang belajar dan dokumentasi lebih mudah diakses.</p></article>
          </div></section>
          <section class="kad-section kad-band" aria-labelledby="after-title"><div><p class="kad-kicker">02 · Setelah bergabung</p><h2 id="after-title">Percakapan tetap punya pagar.</h2></div><ul class="kad-check-list"><li>Baca konteks dan aturan ruang sebelum ikut berdiskusi.</li><li>Gunakan tautan publik sebagai sumber; jadwal terbaru dikonfirmasi di Discord.</li><li>Jaga identitas dan pengalaman orang lain tanpa memaksa atribusi publik.</li></ul></section>
          <section class="kad-section" aria-labelledby="social-title"><div class="kad-section-heading"><p class="kad-kicker">03 · Kanal publik</p><h2 id="social-title">Ikuti sumber yang bisa kamu periksa.</h2></div><div class="kad-grid kad-grid--three"><a class="kad-card kad-source-link" href={X_URL} target="_blank" rel="noopener noreferrer"><strong>X / @KADSocialHub</strong><span>Profil publik dan sumber pengumuman</span></a><a class="kad-card kad-source-link" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer"><strong>Instagram / @kadsocialhub</strong><span>Indeks visual dan sumber komunitas</span></a><a class="kad-card kad-source-link" href={DISCORD_URL} target="_blank" rel="noopener noreferrer"><strong>Discord</strong><span>Ruang percakapan dan konfirmasi</span></a></div></section>
        </>
      )}

      {kind === 'programs' && (
        <>
          <TaskHeader
            eyebrow="Katalog program"
            title="Cari aktivitas yang bisa kamu mulai."
            summary="Semua program berangkat dari sumber publik. Ketersediaan bukan asumsi—konfirmasi langkah berikutnya sebelum ikut."
            variant="catalogue"
            stats={[
              { value: String(PROGRAMS.length), label: 'Program publik', state: 'ready' },
              { value: '2', label: 'Kategori' },
              { value: 'Konfirmasi', label: 'Status terbaru', state: 'pending' },
            ]}
          >
            <a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Tanya di Discord</a>
            <div slot="footer" class="kad-filter-row" aria-label="Jalan pintas kategori program"><a class="kad-pill" href="#all">Semua</a><a class="kad-pill" href="#language">Klub bahasa</a><a class="kad-pill" href="#career">Pendidikan &amp; karier</a></div>
          </TaskHeader>
          <section class="kad-section" aria-labelledby="programs-title">
            <div id="all" class="kad-grid kad-grid--two">
              {PROGRAMS.map((item, index) => {
                const categoryId = item.category === 'Klub bahasa' ? 'language' : 'career';
                const isFirstInCategory = PROGRAMS.findIndex((candidate) => candidate.category === item.category) === index;
                const cover = item.media[0];
                return (
                  <article class="kad-card kad-program-card" id={isFirstInCategory ? categoryId : undefined} data-media-count={item.media.length}>
                    {cover ? (
                      <a class="kad-program-card__media" href={href(`/programs/${item.slug}`)} aria-label={`Lihat detail ${item.title}`}>
                        <img data-program-poster src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                        <p class="kad-media-fallback" hidden>Poster {item.title} gagal dimuat. Buka sumber publik atau detail program untuk dokumentasi dan status.</p>
                      </a>
                    ) : (
                      <div class="kad-program-card__fallback" data-media-state="unavailable">
                        <span class="kad-large-marker" aria-hidden="true">{item.title.slice(0, 1)}</span>
                        <p>Belum ada media milik KAD yang disetujui untuk program ini.</p>
                      </div>
                    )}
                    <div class="kad-card-top"><span class="kad-pill kad-pill-soft">{item.category}</span><span class="kad-status">Konfirmasi di Discord</span></div>
                    <h2 id={`${item.slug}-title`}><a href={href(`/programs/${item.slug}`)}>{item.title}</a></h2>
                    <p>{item.summary}</p>
                    <div class="kad-card-actions"><a class="kad-source-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceLabel} ↗</a><a class="kad-text-link" href={href(`/programs/${item.slug}`)}>Lihat detail</a></div>
                  </article>
                );
              })}
            </div>
            <p id="programs-title" class="kad-note">Poster adalah dokumentasi pengumuman publik, bukan bukti bahwa jadwal lama masih aktif. Ketersediaan, kapasitas, pendaftaran, dan arsip tetap perlu dikonfirmasi.</p>
          </section>
        </>
      )}

      {kind === 'program' && program && (
        <>
          <TaskHeader
            eyebrow={`Program · ${program.category}`}
            title={program.title}
            summary={program.summary}
            variant="record"
            stats={[
              { value: String(program.media.length), label: 'Poster publik', state: program.media.length > 0 ? 'ready' : 'pending' },
              { value: program.category, label: 'Kategori' },
              { value: 'Konfirmasi', label: 'Ketersediaan', state: 'pending' },
            ]}
          >
            <span slot="marker" class="kad-large-marker">{program.title.slice(0, 1)}</span>
            <a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Konfirmasi di Discord</a>
            <a slot="actions" class="kad-source-link" href={program.sourceUrl} target="_blank" rel="noopener noreferrer">Buka sumber publik ↗</a>
          </TaskHeader>
          <section class="kad-section kad-documentation" aria-labelledby="documentation-title" data-program-gallery-count={program.media.length}>
            <div class="kad-section-heading"><div><p class="kad-kicker">Dokumentasi publik</p><h2 id="documentation-title">Poster dari KADSocialHub.</h2></div><p class="kad-note">Dokumentasi ini merekam pengumuman pada tanggal sumber—bukan jadwal aktif otomatis.</p></div>
            {program.media.length > 0 ? (
              <div class:list={['kad-program-gallery', program.media.length === 1 && 'kad-program-gallery--single']}>
                {program.media.map((media, mediaIndex) => (
                  <figure class="kad-program-figure">
                    <div class="kad-program-figure__media">
                      <img data-program-poster src={media.src} alt={media.alt} width={media.width} height={media.height} loading={mediaIndex === 0 ? 'eager' : 'lazy'} decoding="async" />
                      <p class="kad-media-fallback" hidden>{program.title}: poster gagal dimuat. Gunakan tautan sumber publik berikut untuk melihat dokumentasi asli.</p>
                    </div>
                    <figcaption><span>{media.caption}</span><a href={media.sourceUrl} target="_blank" rel="noopener noreferrer">Buka sumber publik ↗</a></figcaption>
                  </figure>
                ))}
              </div>
            ) : (
              <div class="kad-empty-state" data-media-state="unavailable"><span class="kad-status">Tanpa media KAD</span><h3>Dokumentasi visual belum tersedia.</h3><p>Media pada sumber GKS berasal dari akun pihak ketiga, jadi tidak disalin ke website.</p></div>
            )}
          </section>
          <section class="kad-section" aria-labelledby="known-title"><div class="kad-grid kad-grid--two"><article class="kad-card kad-evidence-panel"><p class="kad-kicker">Yang sudah diketahui</p><h2 id="known-title">Berangkat dari sumber.</h2><ul class="kad-check-list">{program.known.map((fact) => <li>{fact}</li>)}</ul></article><article class="kad-card kad-evidence-panel kad-evidence-pending"><p class="kad-kicker">Konfirmasi di Discord</p><h2>Langkah berikutnya.</h2><ul class="kad-check-list">{program.confirm.map((fact) => <li>{fact}</li>)}</ul><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Konfirmasi sekarang</a></article></div></section>
          <section class="kad-section kad-detail-actions"><a class="kad-source-link" href={program.sourceUrl} target="_blank" rel="noopener noreferrer">{program.sourceLabel} ↗</a><a class="kad-text-link" href={href('/programs')}>← Kembali ke program</a></section>
          <section class="kad-section" aria-labelledby="related-title"><div class="kad-section-heading"><p class="kad-kicker">Program lain</p><h2 id="related-title">Mungkin kamu juga ingin melihat.</h2></div><div class="kad-grid kad-grid--three">{PROGRAMS.filter((item) => item.slug !== program.slug).slice(0, 3).map((item) => <a class="kad-card kad-related-card" href={href(`/programs/${item.slug}`)}><span class="kad-pill kad-pill-soft">{item.category}</span><strong>{item.title}</strong><span class="kad-status">Konfirmasi di Discord</span></a>)}</div></section>
        </>
      )}

      {kind === 'events' && (
        <><TaskHeader eyebrow="Meja acara" title="Agenda yang sudah layak dipublikasikan." summary="Jadwal hanya muncul setelah waktu, jalur pendaftaran, dan sumber revisinya disetujui." variant="operational" stats={[{ value: '0', label: 'Acara publik', state: 'pending' }, { value: 'Belum tersedia', label: 'Sinkronisasi', state: 'pending' }, { value: 'Discord', label: 'Konfirmasi saat ini' }]}><a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Tanya jadwal di Discord</a></TaskHeader><section class="kad-section" aria-labelledby="event-state-title"><div class="kad-calendar-spine"><span class="kad-calendar-line" aria-hidden="true"></span><div class="kad-empty-state" data-event-count="0" data-event-state="empty"><span class="kad-status">0 acara publik</span><h2 id="event-state-title">Belum ada rekaman agenda yang lolos review.</h2><p>Scaffold ini akan menampilkan tanggal, zona waktu, status, program, dan sumber revisi tanpa mengubah posting lama menjadi jadwal baru.</p></div></div><div class="kad-state-guide"><details><summary>Jika data menjadi lama</summary><p>Data akan diberi label stale, bukan disajikan sebagai jadwal baru.</p></details><details><summary>Jika layanan bermasalah</summary><p>Status error akan dijelaskan secara tekstual. Data privat tidak menjadi cadangan publik.</p></details></div></section></>
      )}

      {kind === 'event' && (
        <><TaskHeader eyebrow="Dokumentasi acara" title="Acara ini belum dipublikasikan." summary="Catatan publik belum melewati persetujuan sumber, waktu, pendaftaran, recap, dan koreksi." variant="record" stats={[{ value: id ?? 'Tidak tersedia', label: 'Record ID' }, { value: 'Not published', label: 'Status', state: 'pending' }, { value: '0', label: 'Dokumen publik', state: 'pending' }]}><a slot="actions" class="kad-button kad-button--outline" href={href('/events')}>Kembali ke acara</a></TaskHeader><section class="kad-section"><div class="kad-empty-state kad-not-published"><span class="kad-status">Not published</span><h2>Belum ada rekaman publik untuk ditampilkan.</h2><p>Halaman ini disiapkan untuk ringkasan, waktu, pendaftaran, recap, sumber revisi, dan jalur koreksi setelah disetujui.</p></div></section></>
      )}

      {kind === 'volunteer' && (
        <><TaskHeader eyebrow="Cara berkontribusi" title="Kerja komunitas bergerak dalam siklus." summary="Pekerjaan masuk, dikerjakan oleh tim berbasis program, lalu diserahkan tanpa menjadikan identitas publik sebagai syarat." variant="operational" stats={[{ value: '3 bulan', label: 'Satu siklus' }, { value: '3', label: 'Tahap kerja', state: 'ready' }, { value: 'Opt-in', label: 'Atribusi' }]}><a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Mulai percakapan</a></TaskHeader><section class="kad-section" aria-labelledby="cycle-title"><div class="kad-cycle" id="cycle-title"><article class="kad-card"><span class="kad-marker">01</span><h2>Intake</h2><p>Kebutuhan program dan kontribusi dicatat dengan lingkup kerja yang jelas.</p></article><article class="kad-card"><span class="kad-marker">02</span><h2>Program work</h2><p>Tim berbasis program mengerjakan satu langkah yang bisa diserahkan.</p></article><article class="kad-card"><span class="kad-marker">03</span><h2>Handover</h2><p>Catatan dan konteks dipindahkan agar siklus berikutnya tidak mulai dari nol.</p></article></div></section><section class="kad-section kad-band"><h2>Attribution adalah opt-in.</h2><p>Kontribusi publik memakai nama pilihan, lingkup, dan masa berlaku hanya setelah persetujuan.</p></section></>
      )}

      {kind === 'stories' && (
        <><TaskHeader eyebrow="Cerita komunitas" title="Cerita yang bisa diperiksa, bukan ditebak." summary="Atribusi, transkrip, media, dan publikasi final menunggu persetujuan editorial dan consent." variant="evidence" stats={[{ value: '0', label: 'Cerita terbit', state: 'pending' }, { value: '1', label: 'Sumber untuk review' }, { value: 'Pending', label: 'Editorial approval', state: 'pending' }]}><a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Bagikan konteks</a></TaskHeader><section class="kad-section" aria-labelledby="story-state"><div class="kad-empty-state kad-evidence-pending"><span class="kad-status">Menunggu persetujuan</span><h2 id="story-state">Belum ada cerita yang siap terbit.</h2><p>Format Cerita Aja Dulu tersedia sebagai sumber untuk ditinjau, tanpa menyalin identitas atau media.</p><a class="kad-source-link" href="https://www.instagram.com/kadsocialhub/p/DZKQziKv8le/" target="_blank" rel="noopener noreferrer">Sumber publik Cerita Aja Dulu ↗</a></div></section></>
      )}

      {kind === 'history' && (
        <><TaskHeader eyebrow="Memori institusional" title="Sejarah sedang ditinjau." summary="Timeline tetap kosong sampai sumber bertanggal, definisi metrik, atribusi, dan jalur koreksi disetujui." variant="evidence" stats={[{ value: 'Evidence review', label: 'Status', state: 'pending' }, { value: '3', label: 'Syarat publikasi' }, { value: 'Belum siap', label: 'Timeline', state: 'pending' }]}><a slot="actions" class="kad-button kad-button--outline" href={href('/stories')}>Lihat indeks cerita</a></TaskHeader><section class="kad-section"><div class="kad-empty-state" data-claim-state="pending"><span class="kad-status">Evidence review</span><h2>Timeline publik belum siap.</h2><ul class="kad-check-list"><li>Kejadian perlu sumber publik bertanggal dan saling menguatkan.</li><li>Definisi metrik, pemilik editorial, dan atribusi perlu disetujui.</li><li>Harus ada jalur koreksi dan pencabutan sebelum terbit.</li></ul></div></section><section class="kad-section kad-band"><h2>Menemukan koreksi?</h2><p>Kirim konteks melalui komunitas agar dapat masuk ke proses review, tanpa menjanjikan publikasi.</p></section></>
      )}

      {kind === 'impact' && (
        <><TaskHeader eyebrow="Dampak komunitas" title="Definisi dulu, angka kemudian." summary="Setiap metrik membutuhkan periode, sumber, penyebut, dan freshness sebelum menjadi klaim publik." variant="evidence" stats={[{ value: '0', label: 'Total dipublikasikan', state: 'pending' }, { value: '4', label: 'Keluarga metrik', state: 'ready' }, { value: 'Required', label: 'Sumber + periode' }]}><a slot="actions" class="kad-button kad-button--outline" href={href('/support')}>Lihat cara mendukung</a></TaskHeader><section class="kad-section" aria-labelledby="ledger-title"><div class="kad-section-heading"><p class="kad-kicker">Impact ledger</p><h2 id="ledger-title">Empat jenis catatan.</h2></div><div class="kad-grid kad-grid--two"><article class="kad-card"><h3>Aktivitas</h3><p>Sesi dan program yang benar-benar berlangsung.</p></article><article class="kad-card"><h3>Partisipasi</h3><p>Kehadiran dengan definisi dan periode yang jelas.</p></article><article class="kad-card"><h3>Output</h3><p>Dokumentasi atau artefak yang dihasilkan.</p></article><article class="kad-card"><h3>Kontribusi volunteer</h3><p>Lingkup dan waktu kontribusi tanpa mengekspos identitas privat.</p></article></div></section></>
      )}

      {kind === 'support' && (
        <><TaskHeader eyebrow="Dukungan" title="Bantu membuat program tetap bisa dipertanggungjawabkan." summary="Ini proposal akuntabilitas, bukan halaman pembayaran. Dukungan baru layak dikumpulkan setelah batas dan pelaporannya jelas." variant="proposal" stats={[{ value: '4', label: 'Area diusulkan', state: 'ready' }, { value: '0', label: 'Pembayaran aktif', state: 'pending' }, { value: 'Belum siap', label: 'Governance', state: 'pending' }]}><a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Bicarakan dukungan</a></TaskHeader><section class="kad-section" aria-labelledby="support-title"><div class="kad-section-heading"><p class="kad-kicker">Allocation blueprint</p><h2 id="support-title">Area yang diusulkan.</h2></div><div class="kad-grid kad-grid--two">{['Keberlanjutan program', 'Infrastruktur dokumentasi', 'Peralatan volunteer', 'Keselamatan dan moderasi'].map((label) => <article class="kad-card"><span class="kad-status">Proposed</span><h3>{label}</h3><p>Ruang kerja yang perlu pemilik, batas, dan laporan sebelum dianggap funded.</p></article>)}</div></section><section class="kad-section kad-band"><h2>Bagaimana dukungan diatur?</h2><p>Pembayaran baru dapat dipertimbangkan setelah ada pemilik, cadence laporan, kebijakan refund, batas akuntansi, dan laporan penggunaan dana publik.</p></section></>
      )}

      {kind === 'credits' && (
        <><TaskHeader eyebrow="Kredit kontribusi" title="Kontribusi dihargai tanpa memaksa identitas." summary="Nama pilihan, peran, program, siklus, cakupan, masa berlaku, dan pencabutan hanya tampil dengan consent." variant="evidence" stats={[{ value: 'Anonymous', label: 'Default' }, { value: '0', label: 'Kredit disetujui', state: 'pending' }, { value: 'Required', label: 'Consent' }]}><a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Tanyakan proses kontribusi</a></TaskHeader><section class="kad-section"><div class="kad-empty-state" data-claim-state="pending"><span class="kad-status">Anonymous by default</span><h2>Belum ada kredit publik yang disetujui.</h2><p>Discord ID, profil privat, dan identitas tanpa izin tidak pernah masuk ke halaman ini.</p></div></section></>
      )}

      {kind === 'program' && !program && <section class="kad-section"><div class="kad-empty-state"><span class="kad-status">Not published</span><h1>Program tidak ditemukan.</h1><p>Program ini belum memiliki halaman publik.</p><a class="kad-button kad-button--outline" href={href('/programs')}>Kembali ke program</a></div></section>}
    </div>
  </main>
  <Footer client:only="react" locale={locale} />
</Layout>

<script>
  const showPosterFallback = (image: HTMLImageElement) => {
    image.hidden = true;
    const fallback = image.nextElementSibling;
    if (fallback instanceof HTMLElement) fallback.hidden = false;
  };

  document.querySelectorAll<HTMLImageElement>('[data-program-poster]').forEach((image) => {
    image.addEventListener('error', () => showPosterFallback(image), { once: true });
    if (image.complete && image.naturalWidth === 0) showPosterFallback(image);
  });
</script>

<style>
  .kad-translation-notice { margin: 1rem 0 0; padding: .75rem 1rem; border: 1px solid #dfe4ec; border-radius: 999px; color: #687081; font-size: .85rem; }
  .kad-kicker { margin: 0 0 1rem; color: #0055ff; font-size: .78rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .kad-hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr); align-items: end; gap: clamp(2rem, 7vw, 7rem); }
  p { line-height: 1.65; }
  .kad-lede { max-width: 34rem; margin: 0 0 1.5rem; color: #687081; font-size: 1.08rem; }
  .kad-section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; margin-bottom: 1.75rem; }
  .kad-marker, .kad-large-marker { display: inline-flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: #ffbd3e; color: #111318; font-weight: 800; }
  .kad-large-marker { width: 4rem; height: 4rem; margin-bottom: 1.25rem; font-size: 2rem; }
  .kad-card p, .kad-empty-state p { margin: 0; color: #687081; }
  .kad-band { display: grid; grid-template-columns: .8fr 1.2fr; gap: 3rem; padding: 2rem; border-radius: 2rem; background: #edf4ff; }
  .kad-check-list { display: grid; gap: .8rem; margin: 0; padding: 0; list-style: none; }
  .kad-check-list li { position: relative; padding-inline-start: 1.5rem; line-height: 1.5; }
  .kad-check-list li::before { content: '→'; position: absolute; inset-inline-start: 0; color: #0055ff; font-weight: 800; }
