---
import Layout from '@/layouts/Layout.astro';
import type { Locale } from '@/i18n/constants';
import { DISCORD_URL, PROGRAMS, localizedPath, pageTitle, programBySlug, communityCopy, localizedProgram } from '@/content/community-site';
import { activeStagingAttribution, activeStagingContributions, activeStagingMetrics, activeStagingTeams, activeStagingVolunteers, fixtureText, stagingFixturesEnabled, stagingSessionByProgramId, stagingStoryBySlug } from '@/content/staging-fixtures';
import Navbar from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer';
import TaskHeader from '@/components/community-system/TaskHeader.astro';
import DemoBanner from '@/components/community-system/DemoBanner.astro';
import AgendaPage from '@/components/community-system/AgendaPage.astro';
import CommunityOverviewPage from '@/components/community-system/CommunityOverviewPage.astro';
import StoriesPage from '@/components/community-system/StoriesPage.astro';
import VolunteerProfileCard from '@/components/community-system/VolunteerProfileCard.astro';
import MetricCard from '@/components/community-system/MetricCard.astro';
import StatePanel from '@/components/community-system/StatePanel.astro';
import StatusBadge from '@/components/community-system/StatusBadge.astro';
import SessionPreview from '@/components/community-system/SessionPreview.astro';
import AttributionConsentCard from '@/components/community-system/AttributionConsentCard.astro';
import '@/styles/global.css';

interface Props { kind: import('@/content/community-site').CommunityPageKind; locale: Locale; currentPath: string; slug?: string; id?: string; }
const { kind, locale, currentPath, slug, id } = Astro.props;
const fixturesEnabled = stagingFixturesEnabled();
const program = slug ? programBySlug(slug) : undefined;
const localized = program ? localizedProgram(locale, program) : undefined;
const copy = communityCopy(locale, kind);
const description = copy.description;
const href = (path: string): string => localizedPath(locale, path);
const story = kind === 'story' && slug ? stagingStoryBySlug(slug) : undefined;
const title = kind === 'story' && story
    ? `${fixtureText(story.title, locale)} — KaburAjaDulu`
    : pageTitle(kind, localized ?? program, locale);
const isEnglish = locale !== 'id';
const fallbackText = !['id', 'en'].includes(locale)
  ? 'This community surface is available in English while a full translation is prepared.'
  : null;
const contentLanguage = locale === 'id' ? 'id' : 'en';
---

<Layout title={title} description={description} canonical={`https://kaburajadulu.com${currentPath}`} locale={locale} currentPath={currentPath} robots={fixturesEnabled ? 'noindex, nofollow' : undefined}>
  <Navbar client:only="react" locale={locale} currentPath={currentPath} />
  <main id="main-content" class="kad-page" lang={contentLanguage} data-requested-locale={locale} data-fixtures={fixturesEnabled ? 'enabled' : 'disabled'}>
    <div class="kad-container">
      {fallbackText && <p class="kad-translation-notice" lang="en" role="status">{fallbackText}</p>}
      {kind !== 'community' && <DemoBanner locale={locale} />}

      {kind === 'community' && <CommunityOverviewPage locale={locale} href={href} />}
      {(kind === 'stories' || kind === 'story') && <StoriesPage locale={locale} href={href} slug={kind === 'story' ? slug : undefined} />}

      {kind === 'programs' && (
        <>
          <TaskHeader eyebrow={copy.eyebrow} title={copy.title} summary={copy.description} variant="catalogue" locale={locale} stats={[{ value: String(PROGRAMS.length), label: isEnglish ? 'Public programs' : 'Program publik', state: 'ready' }, { value: '2', label: isEnglish ? 'Categories' : 'Kategori' }, { value: isEnglish ? 'Confirm' : 'Konfirmasi', label: isEnglish ? 'Latest status' : 'Status terbaru', state: 'pending' }]}>
            <a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a>
          </TaskHeader>
          <section class="kad-section" aria-labelledby="programs-title"><nav class="kad-filter-row kad-filter-row--content" aria-label={isEnglish ? 'Jump to program categories' : 'Lompat ke kategori program'}><a class="kad-pill" href="#all">{isEnglish ? 'All programs' : 'Semua program'}</a><a class="kad-pill" href="#language">{isEnglish ? 'Language clubs' : 'Klub bahasa'}</a><a class="kad-pill" href="#career">{isEnglish ? 'Education and career' : 'Pendidikan & karier'}</a></nav><div id="all" class="kad-grid kad-grid--two">{PROGRAMS.map((source, index) => { const item = localizedProgram(locale, source); const cover = item.media[0]; const categoryId = source.category === 'Klub bahasa' ? 'language' : 'career'; const firstInCategory = PROGRAMS.findIndex((candidate) => candidate.category === source.category) === index; return <article class="kad-card kad-program-card" id={firstInCategory ? categoryId : undefined} data-program-id={item.slug}>{cover ? <a class="kad-program-card__media" href={href(`/programs/${item.slug}`)}><img data-program-poster src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /><p class="kad-media-fallback" hidden>{isEnglish ? 'Poster failed to load. Open the public source.' : 'Poster gagal dimuat. Buka sumber publik.'}</p></a> : null}<div class="kad-card-top"><span class="kad-pill kad-pill-soft">{item.category}</span><span class="kad-status">{isEnglish ? 'Next session not published' : 'Sesi berikutnya belum dipastikan'}</span></div><h2><a href={href(`/programs/${item.slug}`)}>{item.title}</a></h2><p>{item.summary}</p><div class="kad-card-actions"><a class="kad-source-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceLabel} ↗</a><a class="kad-text-link" href={href(`/programs/${item.slug}`)}>{copy.actions.detail}</a></div></article>; })}</div><p id="programs-title" class="kad-note">{isEnglish ? 'Posters document public announcements. They are not proof of an active schedule.' : 'Poster mendokumentasikan pengumuman publik, bukan bukti jadwal yang masih aktif.'}</p></section>
          {fixturesEnabled && <section class="kad-section" aria-labelledby="sample-sessions-title"><div class="kad-section-heading"><div><p class="kad-kicker">{copy.states.demo}</p><h2 id="sample-sessions-title">{isEnglish ? 'See how a next-session module would work.' : 'Lihat cara modul jadwal berikutnya bekerja.'}</h2></div><p class="kad-note">{isEnglish ? 'These dates are fictional and exist only to review the staging experience.' : 'Tanggal ini fiktif dan hanya dipakai untuk menilai pengalaman staging.'}</p></div><div class="kad-grid kad-grid--two">{PROGRAMS.map((item) => stagingSessionByProgramId(item.slug)).filter((session) => session !== undefined).map((session) => <SessionPreview session={session} locale={locale} programHref={href(`/programs/${session.programId}`)} />)}</div></section>}
        </>
      )}

      {kind === 'program' && localized && (
        <>
          <TaskHeader eyebrow={`${copy.eyebrow} · ${localized.category}`} title={localized.title} summary={localized.summary} variant="record" locale={locale} stats={[{ value: String(localized.media.length), label: isEnglish ? 'Public posters' : 'Poster publik', state: localized.media.length > 0 ? 'ready' : 'pending' }, { value: localized.category, label: isEnglish ? 'Category' : 'Kategori' }, { value: isEnglish ? 'Confirm' : 'Konfirmasi', label: isEnglish ? 'Availability' : 'Ketersediaan', state: 'pending' }]}><a slot="actions" class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></TaskHeader>
          {localized.media.length > 0 && <section class="kad-section kad-documentation" aria-labelledby="documentation-title"><div class:list={['kad-program-gallery', localized.media.length === 1 && 'kad-program-gallery--single']}>{localized.media.map((media) => <figure class="kad-program-figure"><div class="kad-program-figure__media"><img data-program-poster src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" decoding="async" /><p class="kad-media-fallback" hidden>{isEnglish ? 'Poster failed to load. Open the public source.' : 'Poster gagal dimuat. Buka sumber publik.'}</p></div><figcaption><span>{media.caption}</span><a href={media.sourceUrl} target="_blank" rel="noopener noreferrer">{isEnglish ? 'Open public source' : 'Buka sumber publik'} ↗</a></figcaption></figure>)}</div></section>}
          <section class="kad-section" aria-labelledby="known-title"><div class="kad-grid kad-grid--two"><article class="kad-card"><p class="kad-kicker">{isEnglish ? 'Known' : 'Yang sudah diketahui'}</p><h2 id="known-title">{isEnglish ? 'Starts from a source.' : 'Berangkat dari sumber.'}</h2><ul class="kad-check-list">{localized.known.map((fact) => <li>{fact}</li>)}</ul></article><article class="kad-card kad-evidence-pending"><p class="kad-kicker">{isEnglish ? 'Before joining' : 'Sebelum ikut'}</p><h2>{isEnglish ? 'What to check.' : 'Yang perlu diketahui.'}</h2><ul class="kad-check-list">{localized.confirm.map((fact) => <li>{fact}</li>)}</ul><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></article></div></section>
        </>
      )}

      {(kind === 'events' || kind === 'event') && <AgendaPage locale={locale} href={href} id={kind === 'event' ? id : undefined} copy={{ eyebrow: copy.eyebrow, title: copy.title, description: copy.description, discord: copy.actions.discord, back: copy.actions.back }} />}

      {kind === 'volunteer' && (<>
        <header class="kad-subpage-intro kad-subpage-intro--volunteer" aria-labelledby="page-title" data-page-header="volunteer-cycle"><div><p class="kad-eyebrow">{copy.eyebrow}</p><h1 id="page-title">{copy.title}</h1><p>{copy.description}</p></div><div class="kad-subpage-intro__aside"><strong>{isEnglish ? '3-month cycle' : 'Siklus 3 bulan'}</strong><span>{isEnglish ? 'Clear scope, delivery, and handover' : 'Lingkup, hasil, dan serah terima yang jelas'}</span><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></div></header>
        <section class="kad-operational-section" aria-labelledby="cycle-title"><div class="kad-section-heading kad-section-heading--compact"><div><p class="kad-kicker">{isEnglish ? 'How a cycle moves' : 'Alur satu siklus'}</p><h2 id="cycle-title">{isEnglish ? 'One scoped contribution at a time.' : 'Satu kontribusi dengan lingkup jelas.'}</h2></div><p class="kad-note">{isEnglish ? 'Ask about current intake before committing time.' : 'Tanyakan penerimaan yang sedang dibuka sebelum menyisihkan waktu.'}</p></div><ol class="kad-process-list">{(isEnglish ? [['Intake', 'Agree on the need, owner, scope, and expected result.'], ['Program work', 'Deliver one useful outcome with the relevant program team.'], ['Handover', 'Record decisions, files, and follow-up for the next cycle.']] : [['Penerimaan', 'Sepakati kebutuhan, penanggung jawab, lingkup, dan hasil yang diharapkan.'], ['Kerja program', 'Tuntaskan satu hasil berguna bersama tim program terkait.'], ['Serah terima', 'Catat keputusan, berkas, dan tindak lanjut untuk siklus berikutnya.']]).map(([heading, text], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{heading}</h3><p>{text}</p></div></li>)}</ol></section>
        {fixturesEnabled ? <><section class="kad-operational-section kad-operational-section--bordered" aria-labelledby="work-areas-title"><div class="kad-section-heading kad-section-heading--compact"><div><p class="kad-kicker">{isEnglish ? 'Work areas' : 'Area kerja'}</p><h2 id="work-areas-title">{isEnglish ? 'Work is grouped by the result it supports.' : 'Pekerjaan dikelompokkan berdasarkan hasil yang didukung.'}</h2></div></div><div class="kad-work-list">{activeStagingTeams().map((team) => <article data-fixture-id={team.id} data-fixture-state={team.state}><StatusBadge state={team.state} locale={locale} /><div><h3>{fixtureText(team.name, locale)}</h3><p>{fixtureText(team.purpose, locale)}</p><small>{fixtureText(team.handoff, locale)}</small></div></article>)}</div></section><section class="kad-operational-section kad-operational-section--bordered" aria-labelledby="profiles-title"><div class="kad-section-heading kad-section-heading--compact"><div><p class="kad-kicker">{isEnglish ? 'Attribution choices' : 'Pilihan atribusi'}</p><h2 id="profiles-title">{isEnglish ? 'Public credit is optional.' : 'Kredit publik tetap pilihan.'}</h2></div><p class="kad-note">{isEnglish ? 'A contributor can use a chosen name or remain anonymous.' : 'Kontributor dapat memakai nama pilihan atau tetap anonim.'}</p></div><div class="kad-grid kad-grid--three">{activeStagingVolunteers().map((profile) => <VolunteerProfileCard profile={profile} locale={locale} />)}</div></section></> : <section class="kad-operational-section"><StatePanel state="pending" locale={locale} statusLabel={copy.states.pending} title={isEnglish ? 'Volunteer intake is not published yet.' : 'Penerimaan relawan belum dipublikasikan.'} description={isEnglish ? 'Ask in Discord for current openings and their scope.' : 'Tanyakan posisi yang sedang dibuka beserta lingkupnya di Discord.'}><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></StatePanel></section>}
      </>)}

      {kind === 'impact' && (<>
        <header class="kad-subpage-intro kad-subpage-intro--impact" aria-labelledby="page-title" data-page-header="impact-ledger"><div><p class="kad-eyebrow">{copy.eyebrow}</p><h1 id="page-title">{isEnglish ? 'Community impact' : 'Dampak komunitas'}</h1><p>{copy.description}</p></div><div class="kad-subpage-intro__aside"><strong>{fixturesEnabled ? activeStagingMetrics().length : 0} {isEnglish ? 'metrics' : 'metrik'}</strong><span>{fixturesEnabled ? (isEnglish ? 'published preview records' : 'rekaman pratinjau terbit') : (isEnglish ? 'published metric records' : 'rekaman metrik terbit')}</span></div></header>
        <section class="kad-operational-section" aria-labelledby="metrics-title"><div class="kad-section-heading kad-section-heading--compact"><div><p class="kad-kicker">{isEnglish ? 'Impact ledger' : 'Buku dampak'}</p><h2 id="metrics-title">{isEnglish ? 'Read the number together with its method.' : 'Baca angka bersama cara menghitungnya.'}</h2></div><p class="kad-note">{isEnglish ? 'Different measures are kept separate so reach is not confused with participation or completed work.' : 'Setiap ukuran dipisahkan agar jangkauan tidak disamakan dengan partisipasi atau pekerjaan selesai.'}</p></div>{fixturesEnabled ? <div class="kad-metric-ledger">{activeStagingMetrics().map((metric) => <MetricCard metric={metric} locale={locale} />)}</div> : <StatePanel state="pending" locale={locale} statusLabel={copy.states.pending} title={isEnglish ? 'No metric has passed publication review.' : 'Belum ada metrik yang lolos pemeriksaan publikasi.'} description={isEnglish ? 'A metric needs a period, definition, source, method, revision, and correction path.' : 'Metrik membutuhkan periode, definisi, sumber, metode, revisi, dan jalur koreksi.'} />}</section>
      </>)}

      {kind === 'credits' && (
        <>
          <header class="kad-subpage-intro kad-subpage-intro--credits" aria-labelledby="page-title" data-page-header="contribution-ledger"><div><p class="kad-eyebrow">{copy.eyebrow}</p><h1 id="page-title">{isEnglish ? 'Contribution credits' : 'Kredit kontribusi'}</h1><p>{copy.description}</p></div><div class="kad-subpage-intro__aside"><strong>{fixturesEnabled ? activeStagingContributions().length : 0} {isEnglish ? 'contributions' : 'kontribusi'}</strong><span>{fixturesEnabled ? (isEnglish ? 'published preview records' : 'rekaman pratinjau terbit') : (isEnglish ? 'published contribution records' : 'rekaman kontribusi terbit')}</span><small>{isEnglish ? 'Anonymous by default' : 'Anonim secara bawaan'}</small></div></header>
          <section class="kad-operational-section">
            {fixturesEnabled ? (
              <>
                <div class="kad-section-heading kad-section-heading--compact">
                  <div>
                    <p class="kad-kicker">{isEnglish ? 'Contribution ledger' : 'Buku kontribusi'}</p>
                    <h2>{isEnglish ? 'Credit the work without requiring a public identity.' : 'Catat pekerjaannya tanpa mewajibkan identitas publik.'}</h2>
                  </div>
                </div>
                <div class="kad-contribution-ledger">{activeStagingContributions().map((item) => <article data-fixture-id={item.id} data-fixture-state={item.state}><StatusBadge state={item.state} locale={locale} /><div><h3>{fixtureText(item.area, locale)}</h3><p>{fixtureText(item.summary, locale)}</p></div><small>{fixtureText(item.contributor, locale)}</small></article>)}</div>
                <div class="kad-section-heading kad-section-heading--nested">
                  <div>
                    <p class="kad-kicker">{isEnglish ? 'Consent states' : 'Status izin'}</p>
                    <h2>{isEnglish ? 'Names appear only within recorded permission.' : 'Nama hanya tampil sesuai izin yang tercatat.'}</h2>
                  </div>
                  <p class="kad-note">{isEnglish ? 'Withdrawing permission leaves a neutral record; it does not keep the previous identity visible.' : 'Pencabutan izin menyisakan rekaman netral tanpa mempertahankan identitas sebelumnya.'}</p>
                </div>
                <div class="kad-grid kad-grid--three">
                  {activeStagingAttribution().map((consent) => <AttributionConsentCard consent={consent} locale={locale} />)}
                </div>
                <div class="kad-inline-cta"><div><h2>{isEnglish ? 'Want to contribute without public attribution?' : 'Ingin berkontribusi tanpa atribusi publik?'}</h2><p>{isEnglish ? 'Ask about current work and choose how, or whether, your name appears.' : 'Tanyakan pekerjaan yang tersedia dan pilih apakah namamu perlu ditampilkan.'}</p></div><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></div>
              </>
            ) : (
              <StatePanel state="pending" locale={locale} statusLabel={isEnglish ? 'Anonymous by default' : 'Anonim secara bawaan'} title={copy.states.empty} description={isEnglish ? 'Credits stay anonymous until explicit permission is recorded.' : 'Kredit tetap anonim sampai izin tampil tercatat.'}><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></StatePanel>
            )}
          </section>
        </>
      )}

      {kind === 'history' && <><header class="kad-subpage-intro kad-subpage-intro--history" aria-labelledby="page-title" data-page-header="history-review"><div><p class="kad-eyebrow">{copy.eyebrow}</p><h1 id="page-title">{isEnglish ? 'Community history' : 'Sejarah komunitas'}</h1><p>{copy.description}</p></div><div class="kad-subpage-intro__aside"><StatusBadge state="pending" locale={locale} /><strong>{isEnglish ? 'Evidence review' : 'Tinjauan bukti'}</strong><span>{isEnglish ? 'No milestone is public yet' : 'Belum ada tonggak yang dipublikasikan'}</span></div></header><section class="kad-operational-section" aria-labelledby="history-checks-title"><div class="kad-section-heading kad-section-heading--compact"><div><p class="kad-kicker">{isEnglish ? 'Publication checks' : 'Syarat publikasi'}</p><h2 id="history-checks-title">{isEnglish ? 'What a milestone needs before it appears.' : 'Yang dibutuhkan sebelum sebuah tonggak ditampilkan.'}</h2></div></div><ol class="kad-evidence-checks">{(isEnglish ? [['Date and source', 'A dated public or approved record.'], ['Editorial owner', 'Someone accountable for wording and corrections.'], ['Attribution permission', 'Clear permission before naming a person.'], ['Correction path', 'A way to update or withdraw the record.']] : [['Tanggal dan sumber', 'Rekaman publik atau rekaman yang disetujui dan bertanggal.'], ['Penanggung jawab editorial', 'Pihak yang bertanggung jawab atas redaksi dan koreksi.'], ['Izin atribusi', 'Izin yang jelas sebelum menyebut seseorang.'], ['Jalur koreksi', 'Cara memperbarui atau menarik rekaman.']]).map(([heading, text]) => <li><StatusBadge state="pending" locale={locale} /><div><h3>{heading}</h3><p>{text}</p></div></li>)}</ol><div class="kad-inline-cta"><div><h2>{isEnglish ? 'Have a source that can be reviewed?' : 'Punya sumber yang dapat diperiksa?'}</h2><p>{isEnglish ? 'Send the source and context without publishing private material.' : 'Kirim sumber beserta konteksnya tanpa mempublikasikan materi privat.'}</p></div><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></div></section></>}
      {kind === 'support' && <><header class="kad-subpage-intro kad-subpage-intro--support" aria-labelledby="page-title" data-page-header="support-readiness"><div><p class="kad-eyebrow">{copy.eyebrow}</p><h1 id="page-title">{isEnglish ? 'Support KAD' : 'Dukung KAD'}</h1><p>{copy.description}</p></div><div class="kad-readiness-box"><span>{isEnglish ? 'Funding status' : 'Status pendanaan'}</span><strong>{isEnglish ? 'Not accepting payments' : 'Belum menerima pembayaran'}</strong><p>{isEnglish ? 'Contact is open; collection starts only after governance is published.' : 'Diskusi tetap terbuka; pengumpulan baru dimulai setelah tata kelola dipublikasikan.'}</p></div></header><section class="kad-operational-section" aria-labelledby="governance-title"><div class="kad-support-layout"><div><p class="kad-kicker">{isEnglish ? 'Before any financial action' : 'Sebelum menerima dukungan dana'}</p><h2 id="governance-title">{isEnglish ? 'Governance comes first.' : 'Tata kelola harus tersedia lebih dulu.'}</h2><ul class="kad-check-list">{(isEnglish ? ['Named financial owner and accounting boundary', 'Published use-of-funds categories and spending limits', 'Reporting cadence and public outcome record', 'Refund, correction, and escalation policy'] : ['Penanggung jawab keuangan dan batas pembukuan yang jelas', 'Kategori penggunaan dana dan batas pengeluaran yang dipublikasikan', 'Jadwal pelaporan dan rekaman hasil publik', 'Kebijakan pengembalian, koreksi, dan eskalasi']).map((item) => <li>{item}</li>)}</ul></div><div class="kad-support-areas"><h2>{isEnglish ? 'Proposed support areas' : 'Area dukungan yang diusulkan'}</h2>{(isEnglish ? ['Program continuity', 'Documentation infrastructure', 'Volunteer tools', 'Safety and moderation'] : ['Keberlanjutan program', 'Infrastruktur dokumentasi', 'Peralatan relawan', 'Keselamatan dan moderasi']).map((label) => <div><StatusBadge state="pending" locale={locale} /><span>{label}</span></div>)}</div></div><div class="kad-inline-cta"><div><h2>{isEnglish ? 'Discuss non-financial or future support.' : 'Diskusikan dukungan nonfinansial atau rencana ke depan.'}</h2><p>{isEnglish ? 'The conversation does not create a payment obligation.' : 'Percakapan ini tidak menimbulkan kewajiban pembayaran.'}</p></div><a class="kad-button kad-button--primary" href={DISCORD_URL} target="_blank" rel="noopener noreferrer">{copy.actions.discord}</a></div></section></>}
      {kind === 'program' && !localized && <section class="kad-section"><StatePanel state="not-published" locale={locale} statusLabel={copy.states.notPublished} title={isEnglish ? 'Program not found.' : 'Program tidak ditemukan.'} description={isEnglish ? 'This program has no public page.' : 'Program ini belum memiliki halaman publik.'} /></section>}
    </div>
  </main>
  <Footer client:only="react" locale={locale} />
</Layout>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-program-poster]').forEach((image) => {
    const showFallback = () => {
      image.hidden = true;
      const fallback = image.nextElementSibling;
      if (fallback instanceof HTMLElement) fallback.hidden = false;
    };
    image.addEventListener('error', showFallback, { once: true });
    if (image.complete && image.naturalWidth === 0) showFallback();
  });
</script>
