---
import { fixtureText, type EvidenceMetric } from '@/content/staging-fixtures';
import StatusBadge from './StatusBadge.astro';

interface Props { metric: EvidenceMetric; locale?: string; }
const { metric, locale = 'id' } = Astro.props;
const updatedLabel = new Intl.DateTimeFormat(locale === 'id' ? 'id-ID' : 'en-GB', {
  dateStyle: 'medium',
  timeZone: 'Asia/Jakarta',
}).format(new Date(`${metric.updatedAt}T12:00:00+07:00`));
---

<article class="kad-card kad-metric-card" data-fixture-id={metric.id} data-fixture-state={metric.state}>
  <div class="kad-card-top"><span class="kad-kicker">{locale === 'id' ? 'Metrik bukti' : 'Evidence metric'}</span><StatusBadge state={metric.state} locale={locale} /></div>
  <strong class="kad-metric-card__value">{metric.value}</strong>
  <h3>{fixtureText(metric.label, locale)}</h3>
  <p>{fixtureText(metric.definition, locale)}</p>
  <dl class="kad-metric-card__metadata">
    <div><dt>{locale === 'id' ? 'Periode' : 'Period'}</dt><dd>{fixtureText(metric.period, locale)}</dd></div>
    <div><dt>{locale === 'id' ? 'Metode' : 'Method'}</dt><dd data-metric-method>{fixtureText(metric.method, locale)}</dd></div>
    <div><dt>{locale === 'id' ? 'Sumber' : 'Source'}</dt><dd data-metric-source>{fixtureText(metric.sourceLabel, locale)}</dd></div>
    <div><dt>{locale === 'id' ? 'Diperbarui' : 'Updated'}</dt><dd data-metric-updated>{updatedLabel}</dd></div>
  </dl>
</article>
