{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaburajadulu",
  "compatibility_date": "2026-03-18",
  "vars": {
    "COMMUNITY_EVENTS_ENABLED": "false"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "staging": {
      "name": "kaburajadulu-staging",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "COMMUNITY_EVENTS_ENABLED": "false"
      },
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    }
  }
}
