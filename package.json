{
  "name": "astro-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "cf:preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "deploy:ci": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "test:e2e": "playwright test",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "capture:program-references": "playwright test --config=playwright.references.config.ts",
    "test:unit": "bun test tests/unit",
    "test:worker": "bun test tests/worker",
    "validate:interface-runtime": "node scripts/validate-interface-runtime.mjs",
    "test:e2e:community": "playwright test tests/e2e/community-design.spec.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.517.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.6.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.10",
    "@types/node": "^22.20.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wrangler": "~4.118.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "mdast-util-to-hast": "13.2.1",
    "picomatch": "2.3.2",
    "rollup": "4.62.4",
    "sharp": "0.35.3",
    "undici": "8.10.0"
  }
}
