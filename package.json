{
  "name": "astro-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:staging": "PUBLIC_DEPLOY_ENV=staging astro build && node scripts/prepare-staging-artifact.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "cf:preview": "astro build && wrangler dev",
    "validate:staging": "node scripts/validate-staging-config.mjs",
    "deploy": "astro build && wrangler deploy",
    "deploy:ci": "wrangler deploy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "astro": "^7.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.9.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.517.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.9.3",
    "wrangler": "~4.116.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5"
  }
}
